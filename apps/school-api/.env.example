# Gerado por `pnpm setup`.
NODE_ENV=development
PORT=4001
# utilizador eduflow_school_directory: só lê a tabela tenant_databases
DIRECTORY_DATABASE_URL="postgresql://eduflow_school_directory:<senha>@localhost:5435/eduflow_platform?schema=public"
# chave PRIVADA que decifra as credenciais das BDs dos colégios — só existe neste serviço
TENANT_CREDENTIALS_PRIVATE_KEY_FILE=secrets/tenant-credentials.key
TENANT_POOL_SIZE=50
# produção: domínio dos portais (colegio-x.eduflow.ao) — obrigatório com NODE_ENV=production
# TENANT_BASE_DOMAIN=eduflow.ao

# identidade do portal: chaves próprias (nem da equipa, nem dos responsáveis)
SCHOOL_JWT_PRIVATE_KEY_FILE=secrets/school-jwt.key
SCHOOL_JWT_PUBLIC_KEY_FILE=secrets/school-jwt.pub
SCHOOL_MFA_KEY_FILE=secrets/school-mfa.key
JWT_EXPIRES_IN_SECONDS=28800
DEFAULT_PHONE_COUNTRY_CODE="244"
PORTAL_URL_TEMPLATE="http://{slug}.localhost:3002"

# email (Brevo). Sem chave: EMAIL_PROVIDER=console (o email aparece no terminal)
EMAIL_PROVIDER=console
EMAIL_FROM="noreply@eduflow.ao"
EMAIL_FROM_NAME="EduFlow"
EMAIL_REPLY_TO="noreply@eduflow.ao"
EMAIL_API_KEY_FILE=secrets/email-api.key
