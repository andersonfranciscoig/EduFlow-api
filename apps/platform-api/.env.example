# Gerado por `pnpm setup`. Em produção: variáveis do contentor + chaves montadas como secrets.
NODE_ENV=development
PORT=4000
FRONTEND_URL="http://localhost:3001"
# utilizador eduflow_platform_app: só dados, sem DDL, sem acesso às credenciais dos colégios
PLATFORM_DATABASE_URL="postgresql://eduflow_platform_app:<senha>@localhost:5435/eduflow_platform?schema=public"
# pares de chaves ES256 — só este serviço os tem
STAFF_JWT_PRIVATE_KEY_FILE=secrets/staff-jwt.key
STAFF_JWT_PUBLIC_KEY_FILE=secrets/staff-jwt.pub
CUSTOMER_JWT_PRIVATE_KEY_FILE=secrets/customer-jwt.key
CUSTOMER_JWT_PUBLIC_KEY_FILE=secrets/customer-jwt.pub
# chave AES-256 que cifra os segredos da 2FA guardados na BD
MFA_ENCRYPTION_KEY_FILE=secrets/mfa.key
JWT_EXPIRES_IN_SECONDS=28800
DEFAULT_PHONE_COUNTRY_CODE="244"
STORAGE_DIR=./storage/platform
