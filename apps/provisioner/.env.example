# Gerado por `pnpm setup`.
NODE_ENV=development
# utilizador eduflow_provisioner: CREATEDB/CREATEROLE; só toca na fila e no diretório
PROVISIONER_DATABASE_URL="postgresql://eduflow_provisioner:<senha>@localhost:5435/eduflow_platform?schema=public"
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5435
# chave PÚBLICA (cifra as credenciais; não as consegue decifrar)
TENANT_CREDENTIALS_PUBLIC_KEY_FILE=secrets/tenant-credentials.pub
POLL_INTERVAL_MS=3000
MAX_ATTEMPTS=5
