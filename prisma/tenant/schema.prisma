// =============================================================================
//  EduFlow — Base de dados de CADA COLÉGIO (Módulo 2)
//  Uma base de dados por colégio, com o seu próprio utilizador PostgreSQL.
//  As migrações (prisma/tenant/migrations) são aplicadas pelo provisioner.
//  Gerar o SQL de uma nova migração: pnpm db:tenant-sql
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/tenant-client"
}

datasource db {
  provider = "postgresql"
  // Só usado pelo CLI; em runtime o URL é montado a partir do diretório.
  url      = env("TENANT_DATABASE_URL")
}

/// Identidade do colégio dentro da sua própria base de dados (linha única).
model TenantInfo {
  id        Int      @id @default(1)
  schoolId  String   @map("school_id") @db.Uuid
  slug      String
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("tenant_info")
}

// =============================================================================
//  IDENTIDADE — pessoas do colégio que entram no portal (direção, secretaria,
//  professores). Vivem SÓ na BD do colégio: a plataforma não as vê.
//  Fluxo: identificar → senha → código da app (2FA obrigatória).
//  O responsável (DIRETOR, is_owner) é criado pelo provisioner como INVITED e
//  ativa a conta com um código enviado para o seu email.
// =============================================================================

enum SchoolRole {
  DIRETOR
  SECRETARIA
  PROFESSOR
}

enum SchoolUserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum EmailCodePurpose {
  ACTIVATION
  PASSWORD_RESET
}

model SchoolUser {
  id                         String           @id @db.Uuid
  fullName                   String           @map("full_name")
  email                      String?          @unique
  phone                      String?          @unique
  /// NULL enquanto a conta não for ativada
  passwordHash               String?          @map("password_hash")
  role                       SchoolRole
  status                     SchoolUserStatus
  /// Responsável do colégio (só um — índice único parcial na migração)
  isOwner                    Boolean          @default(false) @map("is_owner")
  failedLoginAttempts        Int              @default(0) @map("failed_login_attempts")
  lockedUntil                DateTime?        @map("locked_until")
  lastLoginAt                DateTime?        @map("last_login_at")
  /// Segredos TOTP cifrados (AES-256-GCM, chave só do school-api)
  mfaSecretCiphertext        String?          @map("mfa_secret_ciphertext")
  mfaPendingSecretCiphertext String?          @map("mfa_pending_secret_ciphertext")
  mfaEnabledAt               DateTime?        @map("mfa_enabled_at")
  mfaLastUsedStep            Int?             @map("mfa_last_used_step")
  mfaRecoveryCodeHashes      String[]         @default([]) @map("mfa_recovery_code_hashes")
  createdAt                  DateTime         @default(now()) @map("created_at")
  updatedAt                  DateTime         @updatedAt @map("updated_at")

  sessions    SchoolSession[]
  codes       EmailCode[]
  permissions SchoolUserPermission[]

  @@map("school_users")
}

/// Permissão granular de um utilizador (ex.: "hr.access"). O responsável tem todas, sem linhas.
model SchoolUserPermission {
  userId      String     @map("user_id") @db.Uuid
  user        SchoolUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission  String
  grantedById String?    @map("granted_by_id") @db.Uuid
  grantedAt   DateTime   @map("granted_at")

  @@id([userId, permission])
  @@index([permission])
  @@map("school_user_permissions")
}

/// Sessão aberta depois da 2FA. Revogar invalida o token de imediato.
model SchoolSession {
  id            String     @id @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  user          SchoolUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip            String?
  userAgent     String?    @map("user_agent")
  createdAt     DateTime   @map("created_at")
  lastSeenAt    DateTime   @map("last_seen_at")
  expiresAt     DateTime   @map("expires_at")
  mfaVerifiedAt DateTime   @map("mfa_verified_at")
  revokedAt     DateTime?  @map("revoked_at")
  revokedReason String?    @map("revoked_reason")

  @@index([userId])
  @@map("school_sessions")
}

/// Códigos de 6 dígitos enviados por email (ativação e recuperação da senha).
/// Guarda-se só o hash; expiram em 15 min e aceitam 5 tentativas.
model EmailCode {
  id         String           @id @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  user       SchoolUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    EmailCodePurpose
  codeHash   String           @map("code_hash")
  attempts   Int              @default(0)
  expiresAt  DateTime         @map("expires_at")
  consumedAt DateTime?        @map("consumed_at")
  createdAt  DateTime         @map("created_at")

  @@index([userId, purpose, createdAt])
  @@map("email_codes")
}

/// Histórico de segurança das contas do colégio.
model SchoolActivity {
  id         String   @id @db.Uuid
  type       String
  subjectId  String   @map("subject_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  details    Json?
  occurredAt DateTime @map("occurred_at")

  @@index([subjectId, occurredAt])
  @@map("school_activity")
}

// =============================================================================
//  SUPORTE EDUFLOW — o colégio decide se (e até quando) a equipa pode entrar
// =============================================================================

/// Autorização dada pelo diretor/responsável. Sem uma ativa, ninguém da EduFlow
/// entra (exceto emergência pedida por um administrador, sempre avisada por email).
model SupportGrant {
  id          String    @id @db.Uuid
  grantedById String    @map("granted_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  revokedById String?   @map("revoked_by_id") @db.Uuid
  createdAt   DateTime  @map("created_at")

  @@index([expiresAt])
  @@map("support_grants")
}

/// Cada entrada da equipa EduFlow: quem, porquê, em que modo e até quando.
model SupportSession {
  id         String    @id @db.Uuid
  /// id do bilhete emitido pela plataforma — cada bilhete só serve uma vez
  ticketId   String    @unique @map("ticket_id")
  staffId    String    @map("staff_id") @db.Uuid
  staffName  String    @map("staff_name")
  staffEmail String?   @map("staff_email")
  /// READ (só leitura) | WRITE
  mode       String
  emergency  Boolean   @default(false)
  reason     String
  grantId    String?   @map("grant_id") @db.Uuid
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @map("created_at")
  lastSeenAt DateTime  @map("last_seen_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  revokedReason String? @map("revoked_reason")

  @@index([createdAt])
  @@map("support_sessions")
}

// =============================================================================
//  ÁREA PEDAGÓGICA — tudo dentro de um ano letivo: ano → classes → turmas
//  (restrições extra na migração 0004: datas, um só ano ativo, nomes únicos)
// =============================================================================

model AcademicYear {
  id          String    @id @db.Uuid
  name        String
  startsOn    DateTime  @map("starts_on") @db.Date
  endsOn      DateTime  @map("ends_on") @db.Date
  /// PLANNED | ACTIVE | CLOSED
  status      String    @default("PLANNED")
  createdById String?   @map("created_by_id") @db.Uuid
  activatedAt DateTime? @map("activated_at")
  closedAt    DateTime? @map("closed_at")
  createdAt   DateTime  @map("created_at")
  updatedAt   DateTime  @map("updated_at")

  classes        SchoolClass[]
  groups         ClassGroup[]
  reservations   SeatReservation[]
  classSubjects  ClassSubject[]
  lessons        Lesson[]
  classFees      ClassFee[]
  feePlan        FeePlan?

  @@index([startsOn])
  @@map("academic_years")
}

model SchoolClass {
  id             String       @id @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  /// 0 = Iniciação; 1–6 Primário; 7–9 I Ciclo; 10–13 II Ciclo
  grade          Int
  /// Obrigatório no II Ciclo (podem existir várias 10.ª, uma por curso)
  courseId       String?      @map("course_id") @db.Uuid
  course         Course?      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  description    String?
  /// Vagas para o ano letivo (direção). null = usar os lugares das turmas
  vacancies      Int?
  createdAt      DateTime     @map("created_at")

  groups       ClassGroup[]
  reservations SeatReservation[]
  subjects     ClassSubject[]
  fees         ClassFee[]

  @@index([courseId])
  @@map("school_classes")
}

/// Catálogo de cursos do colégio (atravessa os anos). GERAL: 10.ª–12.ª · TECNICO: 10.ª–13.ª
model Course {
  id          String    @id @db.Uuid
  name        String
  /// sigla (ex.: CFB)
  code        String?
  /// GERAL | TECNICO
  kind        String    @default("GERAL")
  description String?
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @map("created_at")
  updatedAt   DateTime  @map("updated_at")

  classes SchoolClass[]

  @@map("courses")
}

model ClassGroup {
  id             String       @id @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classId        String       @map("class_id") @db.Uuid
  schoolClass    SchoolClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  name           String
  /// MANHA | TARDE | NOITE
  shift          String
  room           String?
  capacity       Int?
  createdAt      DateTime     @map("created_at")
  updatedAt      DateTime     @map("updated_at")

  reservations SeatReservation[]
  lessons      Lesson[]

  @@index([academicYearId])
  @@map("class_groups")
}

/// Catálogo de disciplinas do colégio (atravessa os anos).
model Subject {
  id         String    @id @db.Uuid
  name       String
  /// sigla (ex.: MAT)
  code       String
  /// cor no horário (#rrggbb)
  color      String
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @map("created_at")
  updatedAt  DateTime  @map("updated_at")

  classes ClassSubject[]
  lessons Lesson[]

  @@map("subjects")
}

/// Plano curricular: disciplina de uma classe (no ano) e tempos por semana.
model ClassSubject {
  id             String       @id @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classId        String       @map("class_id") @db.Uuid
  schoolClass    SchoolClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId      String       @map("subject_id") @db.Uuid
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  weeklyPeriods  Int          @map("weekly_periods")
  position       Int          @default(0)
  createdAt      DateTime     @map("created_at")

  @@unique([classId, subjectId])
  @@index([subjectId])
  @@map("class_subjects")
}

/// Tempos letivos de um turno (aula ou intervalo).
model SchoolPeriod {
  id        String   @id @db.Uuid
  /// MANHA | TARDE | NOITE
  shift     String
  position  Int
  startsAt  DateTime @map("starts_at") @db.Time(0)
  endsAt    DateTime @map("ends_at") @db.Time(0)
  /// AULA | INTERVALO
  kind      String   @default("AULA")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  lessons Lesson[]

  @@unique([shift, position])
  @@map("school_periods")
}

/// Horário: turma × dia × tempo → disciplina (+ sala, + professor quando existir).
model Lesson {
  id             String       @id @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  groupId        String       @map("group_id") @db.Uuid
  group          ClassGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// 1 = segunda … 5 = sexta
  weekday        Int
  periodId       String       @map("period_id") @db.Uuid
  period         SchoolPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  subjectId      String       @map("subject_id") @db.Uuid
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  /// professor — vazio até existir o módulo de professores
  teacherId      String?      @map("teacher_id") @db.Uuid
  room           String?
  createdAt      DateTime     @map("created_at")
  updatedAt      DateTime     @map("updated_at")

  @@unique([groupId, weekday, periodId])
  @@index([subjectId])
  @@map("lessons")
}

/// Ocupação de vagas: HELD (reservada, com prazo) → CONFIRMED (aluno numa turma) → RELEASED.
model SeatReservation {
  id             String       @id @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classId        String       @map("class_id") @db.Uuid
  schoolClass    SchoolClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  groupId        String?      @map("group_id") @db.Uuid
  group          ClassGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  /// HELD | CONFIRMED | RELEASED
  status         String
  /// quem ocupa (ex.: n.º da inscrição)
  reference      String
  expiresAt      DateTime?    @map("expires_at")
  createdAt      DateTime     @map("created_at")
  updatedAt      DateTime     @map("updated_at")

  @@index([classId, status])
  @@index([academicYearId, status])
  @@map("seat_reservations")
}

// =============================================================================
//  FINANÇAS — preçário (rubricas, preço por classe/curso, calendário das propinas)
// =============================================================================

/// Rubrica de cobrança (Propina, Matrícula, Confirmação, Uniforme…). Atravessa os anos.
model FeeItem {
  id         String    @id @db.Uuid
  name       String
  /// MENSAL | UNICA
  billing    String
  /// TODOS | NOVOS | CONTINUANTES
  appliesTo  String    @default("TODOS") @map("applies_to")
  position   Int       @default(0)
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @map("created_at")
  updatedAt  DateTime  @map("updated_at")

  prices ClassFee[]

  @@map("fee_items")
}

/// Preço de uma rubrica numa classe do ano (no II Ciclo, a classe já é por curso). Kwanzas.
model ClassFee {
  id             String       @id @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classId        String       @map("class_id") @db.Uuid
  schoolClass    SchoolClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  feeItemId      String       @map("fee_item_id") @db.Uuid
  feeItem        FeeItem      @relation(fields: [feeItemId], references: [id], onDelete: Restrict)
  amount         Int
  updatedById    String?      @map("updated_by_id") @db.Uuid
  createdAt      DateTime     @map("created_at")
  updatedAt      DateTime     @map("updated_at")

  @@unique([classId, feeItemId])
  @@index([academicYearId])
  @@index([feeItemId])
  @@map("class_fees")
}

/// Calendário das propinas do ano: meses cobrados, dia limite e multa por atraso.
model FeePlan {
  academicYearId String       @id @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  /// ["2026-09", "2026-10", …]
  months         Json
  dueDay         Int          @default(10) @map("due_day")
  /// NONE | PERCENT | FIXED
  lateFeeKind    String       @default("NONE") @map("late_fee_kind")
  lateFeeValue   Int          @default(0) @map("late_fee_value")
  updatedById    String?      @map("updated_by_id") @db.Uuid
  createdAt      DateTime     @map("created_at")
  updatedAt      DateTime     @map("updated_at")

  @@map("fee_plans")
}

// =============================================================================
//  RECURSOS HUMANOS — configuração do cadastro de funcionários
// =============================================================================

/// Secção configurável do cadastro (ACADEMIC | PROFESSIONAL).
model HrFormSection {
  key         String   @id
  title       String
  description String?
  repeatable  Boolean  @default(false)
  entryLabel  String   @map("entry_label")
  maxEntries  Int      @default(10) @map("max_entries")
  position    Int
  updatedAt   DateTime @map("updated_at")

  fields HrFormField[]

  @@map("hr_form_sections")
}

/// Campo pedido numa secção (tipo, obrigatório, ajuda, opções, regras).
model HrFormField {
  id         String        @id @db.Uuid
  sectionKey String        @map("section")
  section    HrFormSection @relation(fields: [sectionKey], references: [key], onDelete: Restrict)
  label      String
  /// TEXT | LONG_TEXT | NUMBER | DATE | EMAIL | PHONE | SELECT | MULTI_SELECT | BOOLEAN | FILE
  type       String
  required   Boolean       @default(false)
  help       String?
  options    Json          @default("[]")
  settings   Json          @default("{}")
  position   Int
  active     Boolean       @default(true)
  /// tipos de funcionário a que se aplica (vazio = todos)
  employeeTypeIds String[] @default([]) @map("employee_type_ids") @db.Uuid
  createdAt  DateTime      @map("created_at")
  updatedAt  DateTime      @map("updated_at")

  @@index([sectionKey, position])
  @@map("hr_form_fields")
}

/// Tipo de funcionário (ex.: Docente, Administrativo, Auxiliar): define que campos e documentos lhe aparecem.
model HrEmployeeType {
  id          String   @id @db.Uuid
  name        String
  description String?
  position    Int
  active      Boolean  @default(true)
  createdAt   DateTime @map("created_at")
  updatedAt   DateTime @map("updated_at")

  requests  EmployeeRegistrationRequest[]
  invites   EmployeeRegistrationInvite[]
  employees Employee[]

  @@map("hr_employee_types")
}

/// Pedido de cadastro (página pública do colégio). PENDING → APPROVED | REJECTED | CANCELLED.
model EmployeeRegistrationRequest {
  id              String          @id @db.Uuid
  fullName        String          @map("full_name")
  email           String
  phone           String?
  passwordHash    String          @map("password_hash")
  employeeTypeId  String?         @map("employee_type_id") @db.Uuid
  employeeType    HrEmployeeType? @relation(fields: [employeeTypeId], references: [id], onDelete: SetNull)
  status          String          @default("PENDING")
  termsAcceptedAt DateTime        @map("terms_accepted_at")
  ip              String?
  userAgent       String?         @map("user_agent")
  decidedById     String?         @map("decided_by_id") @db.Uuid
  decidedAt       DateTime?       @map("decided_at")
  decisionReason  String?         @map("decision_reason")
  createdAt       DateTime        @map("created_at")
  updatedAt       DateTime        @map("updated_at")

  invites  EmployeeRegistrationInvite[]
  employee Employee?

  @@index([status, createdAt])
  @@map("employee_registration_requests")
}

/// Convite para o formulário: só o SHA-256 do token; validade; reenviar revoga o anterior.
model EmployeeRegistrationInvite {
  id             String                      @id @db.Uuid
  requestId      String                      @map("request_id") @db.Uuid
  request        EmployeeRegistrationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  tokenHash      String                      @unique @map("token_hash")
  employeeTypeId String?                     @map("employee_type_id") @db.Uuid
  employeeType   HrEmployeeType?             @relation(fields: [employeeTypeId], references: [id], onDelete: SetNull)
  expiresAt      DateTime                    @map("expires_at")
  sentAt         DateTime?                   @map("sent_at")
  sendError      String?                     @map("send_error")
  revokedAt      DateTime?                   @map("revoked_at")
  failedAttempts Int                         @default(0) @map("failed_attempts")
  lockedUntil    DateTime?                   @map("locked_until")
  lastUsedAt     DateTime?                   @map("last_used_at")
  createdById    String?                     @map("created_by_id") @db.Uuid
  createdAt      DateTime                    @map("created_at")
  /// sessão do formulário (SHA-256 do token; o token só existe no cookie do portal)
  sessionHash       String?                  @unique @map("session_hash")
  sessionExpiresAt  DateTime?                @map("session_expires_at")
  expiredNotifiedAt DateTime?                @map("expired_notified_at")

  @@map("employee_registration_invites")
}

/// Quem decidiu o quê (pedidos e cadastros): estado anterior, novo, justificação.
model EmployeeApprovalHistory {
  id          String   @id @db.Uuid
  subjectType String   @map("subject_type")
  subjectId   String   @map("subject_id") @db.Uuid
  fromStatus  String?  @map("from_status")
  toStatus    String   @map("to_status")
  actorId     String?  @map("actor_id") @db.Uuid
  actorName   String?  @map("actor_name")
  reason      String?
  createdAt   DateTime @map("created_at")

  @@index([subjectType, subjectId, createdAt])
  @@map("employee_approval_history")
}

/// Documento pedido aos funcionários.
model HrDocumentType {
  id          String   @id @db.Uuid
  name        String
  description String?
  required    Boolean  @default(false)
  /// pdf, jpg, png, webp, doc, docx
  formats     String[]
  maxSizeMb   Int      @default(5) @map("max_size_mb")
  multiple    Boolean  @default(false)
  position    Int
  active      Boolean  @default(true)
  /// tipos de funcionário a que se aplica (vazio = todos)
  employeeTypeIds String[] @default([]) @map("employee_type_ids") @db.Uuid
  createdAt   DateTime @map("created_at")
  updatedAt   DateTime @map("updated_at")

  @@map("hr_document_types")
}

/// Versão publicada da configuração (fotografia em JSON). Os cadastros ficam presos à sua versão.
model HrFormVersion {
  id            String   @id @db.Uuid
  number        Int      @unique
  snapshot      Json
  publishedById String?  @map("published_by_id") @db.Uuid
  publishedAt   DateTime @map("published_at")

  employees Employee[]

  @@map("hr_form_versions")
}

/// Cadastro de funcionário, preso à versão do formulário com que começou. Dados em JSONB validados pela API.
model Employee {
  id             String                       @id @db.Uuid
  number         Int?                         @unique
  requestId      String?                      @unique @map("request_id") @db.Uuid
  request        EmployeeRegistrationRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  employeeTypeId String?                      @map("employee_type_id") @db.Uuid
  employeeType   HrEmployeeType?              @relation(fields: [employeeTypeId], references: [id], onDelete: SetNull)
  formVersionId  String                       @map("form_version_id") @db.Uuid
  formVersion    HrFormVersion                @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  status         String                       @default("DRAFT")
  progress       String                       @default("NOT_STARTED")
  lastStep       String?                      @map("last_step")
  completedSteps String[]                     @default([]) @map("completed_steps")
  revision       Int                          @default(0)
  personal       Json                         @default("{}")
  sections       Json                         @default("{}")
  fullName       String                       @map("full_name")
  email          String?
  phone          String?
  jobTitle       String?                      @map("job_title")
  department     String?
  correctionNote String?                      @map("correction_note")
  createdById    String?                      @map("created_by_id") @db.Uuid
  submittedAt    DateTime?                    @map("submitted_at")
  approvedAt     DateTime?                    @map("approved_at")
  activatedAt    DateTime?                    @map("activated_at")
  terminatedAt   DateTime?                    @map("terminated_at")
  createdAt      DateTime                     @map("created_at")
  updatedAt      DateTime                     @map("updated_at")

  documents EmployeeDocument[]

  @@index([status, createdAt])
  @@index([employeeTypeId])
  @@map("employees")
}

/// Ficheiro entregue (conteúdo cifrado no armazenamento externo; aqui só a chave interna).
model EmployeeDocument {
  id           String   @id @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// PHOTO | DOCUMENT | FIELD
  slot         String
  itemId       String?  @map("item_id") @db.Uuid
  label        String
  fileName     String   @map("file_name")
  mimeType     String   @map("mime_type")
  size         Int
  sha256       String
  storageKey   String   @map("storage_key")
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @map("created_at")

  @@index([employeeId, slot, createdAt])
  @@map("employee_documents")
}

