// =============================================================================
//  EduFlow — Base de dados de CADA COLÉGIO (Módulo 2)
//  Uma base de dados por colégio, com o seu próprio utilizador PostgreSQL.
//  As migrações (prisma/tenant/migrations) são aplicadas pelo provisioner.
//  Gerar o SQL de uma nova migração: pnpm db:tenant-sql
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/tenant-client"
}

datasource db {
  provider = "postgresql"
  // Só usado pelo CLI; em runtime o URL é montado a partir do diretório.
  url      = env("TENANT_DATABASE_URL")
}

/// Identidade do colégio dentro da sua própria base de dados (linha única).
model TenantInfo {
  id        Int      @id @default(1)
  schoolId  String   @map("school_id") @db.Uuid
  slug      String
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("tenant_info")
}

// =============================================================================
//  IDENTIDADE — pessoas do colégio que entram no portal (direção, secretaria,
//  professores). Vivem SÓ na BD do colégio: a plataforma não as vê.
//  Fluxo: identificar → senha → código da app (2FA obrigatória).
//  O responsável (DIRETOR, is_owner) é criado pelo provisioner como INVITED e
//  ativa a conta com um código enviado para o seu email.
// =============================================================================

enum SchoolRole {
  DIRETOR
  SECRETARIA
  PROFESSOR
  /// só a área dos Recursos Humanos
  RH
}

enum SchoolUserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum EmailCodePurpose {
  ACTIVATION
  PASSWORD_RESET
}

model SchoolUser {
  id                         String           @id @db.Uuid
  fullName                   String           @map("full_name")
  email                      String?          @unique
  phone                      String?          @unique
  /// NULL enquanto a conta não for ativada
  passwordHash               String?          @map("password_hash")
  role                       SchoolRole
  status                     SchoolUserStatus
  /// Responsável do colégio (só um — índice único parcial na migração)
  isOwner                    Boolean          @default(false) @map("is_owner")
  failedLoginAttempts        Int              @default(0) @map("failed_login_attempts")
  lockedUntil                DateTime?        @map("locked_until")
  lastLoginAt                DateTime?        @map("last_login_at")
  /// Segredos TOTP cifrados (AES-256-GCM, chave só do school-api)
  mfaSecretCiphertext        String?          @map("mfa_secret_ciphertext")
  mfaPendingSecretCiphertext String?          @map("mfa_pending_secret_ciphertext")
  mfaEnabledAt               DateTime?        @map("mfa_enabled_at")
  mfaLastUsedStep            Int?             @map("mfa_last_used_step")
  mfaRecoveryCodeHashes      String[]         @default([]) @map("mfa_recovery_code_hashes")
  createdAt                  DateTime         @default(now()) @map("created_at")
  updatedAt                  DateTime         @updatedAt @map("updated_at")

  sessions    SchoolSession[]
  codes       EmailCode[]
  permissions SchoolUserPermission[]
  /// o funcionário a quem pertence esta conta (ex.: professor)
  employee    Employee?

  @@map("school_users")
}

/// Permissão granular de um utilizador (ex.: "hr.access"). O responsável tem todas, sem linhas.
model SchoolUserPermission {
  userId      String     @map("user_id") @db.Uuid
  user        SchoolUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission  String
  grantedById String?    @map("granted_by_id") @db.Uuid
  grantedAt   DateTime   @map("granted_at")

  @@id([userId, permission])
  @@index([permission])
  @@map("school_user_permissions")
}

/// Sessão aberta depois da 2FA. Revogar invalida o token de imediato.
model SchoolSession {
  id            String     @id @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  user          SchoolUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip            String?
  userAgent     String?    @map("user_agent")
  createdAt     DateTime   @map("created_at")
  lastSeenAt    DateTime   @map("last_seen_at")
  expiresAt     DateTime   @map("expires_at")
  mfaVerifiedAt DateTime   @map("mfa_verified_at")
  revokedAt     DateTime?  @map("revoked_at")
  revokedReason String?    @map("revoked_reason")

  @@index([userId])
  @@map("school_sessions")
}

/// Códigos de 6 dígitos enviados por email (ativação e recuperação da senha).
/// Guarda-se só o hash; expiram em 15 min e aceitam 5 tentativas.
model EmailCode {
  id         String           @id @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  user       SchoolUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    EmailCodePurpose
  codeHash   String           @map("code_hash")
  attempts   Int              @default(0)
  expiresAt  DateTime         @map("expires_at")
  consumedAt DateTime?        @map("consumed_at")
  createdAt  DateTime         @map("created_at")

  @@index([userId, purpose, createdAt])
  @@map("email_codes")
}

/// Histórico de segurança das contas do colégio.
model SchoolActivity {
  id         String   @id @db.Uuid
  type       String
  subjectId  String   @map("subject_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  details    Json?
  occurredAt DateTime @map("occurred_at")

  @@index([subjectId, occurredAt])
  @@map("school_activity")
}

// =============================================================================
//  SUPORTE EDUFLOW — o colégio decide se (e até quando) a equipa pode entrar
// =============================================================================

/// Autorização dada pelo diretor/responsável. Sem uma ativa, ninguém da EduFlow
/// entra (exceto emergência pedida por um administrador, sempre avisada por email).
model SupportGrant {
  id          String    @id @db.Uuid
  grantedById String    @map("granted_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  revokedById String?   @map("revoked_by_id") @db.Uuid
  createdAt   DateTime  @map("created_at")

  @@index([expiresAt])
  @@map("support_grants")
}

/// Cada entrada da equipa EduFlow: quem, porquê, em que modo e até quando.
model SupportSession {
  id         String    @id @db.Uuid
  /// id do bilhete emitido pela plataforma — cada bilhete só serve uma vez
  ticketId   String    @unique @map("ticket_id")
  staffId    String    @map("staff_id") @db.Uuid
  staffName  String    @map("staff_name")
  staffEmail String?   @map("staff_email")
  /// READ (só leitura) | WRITE
  mode       String
  emergency  Boolean   @default(false)
  reason     String
  grantId    String?   @map("grant_id") @db.Uuid
  ip         String?
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @map("created_at")
  lastSeenAt DateTime  @map("last_seen_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  revokedReason String? @map("revoked_reason")

  @@index([createdAt])
  @@map("support_sessions")
}

// =============================================================================
//  ÁREA PEDAGÓGICA — tudo dentro de um ano letivo: ano → classes → turmas
//  (restrições extra na migração 0004: datas, um só ano ativo, nomes únicos)
// =============================================================================

model AcademicYear {
  id          String    @id @db.Uuid
  name        String
  startsOn    DateTime  @map("starts_on") @db.Date
  endsOn      DateTime  @map("ends_on") @db.Date
  /// PLANNED | ACTIVE | CLOSED
  status      String    @default("PLANNED")
  createdById String?   @map("created_by_id") @db.Uuid
  activatedAt DateTime? @map("activated_at")
  closedAt    DateTime? @map("closed_at")
  /// TRIMESTRE (3 períodos) | SEMESTRE (2)
  periodKind  String    @default("TRIMESTRE") @map("period_kind")
  createdAt   DateTime  @map("created_at")
  updatedAt   DateTime  @map("updated_at")

  periods        AcademicPeriod[]
  closures       SchoolClosure[]
  classes        SchoolClass[]
  groups         ClassGroup[]
  reservations   SeatReservation[]
  classSubjects  ClassSubject[]
  lessons        Lesson[]
  classFees      ClassFee[]
  feePlan        FeePlan?
  admissionPeriods AdmissionPeriods?
  applications   Application[]
  enrollments    Enrollment[]
  enrollmentCounter EnrollmentCounter?

  @@index([startsOn])
  @@map("academic_years")
}

/// Período de avaliação do ano letivo (1.º, 2.º, 3.º trimestre ou semestre).
model AcademicPeriod {
  id             String       @id @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  position       Int
  startsOn       DateTime     @map("starts_on") @db.Date
  endsOn         DateTime     @map("ends_on") @db.Date
  createdAt      DateTime     @map("created_at")
  updatedAt      DateTime     @map("updated_at")
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade, map: "academic_periods_year_fkey")

  @@unique([academicYearId, position], map: "academic_periods_year_position_key")
  @@map("academic_periods")
}

/// Dias sem aulas (feriados, pausas…): sem aulas a registar nem pendências.
model SchoolClosure {
  id             String       @id @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  startsOn       DateTime     @map("starts_on") @db.Date
  endsOn         DateTime     @map("ends_on") @db.Date
  /// FERIADO | PAUSA | OUTRO
  kind           String
  reason         String
  createdById    String?      @map("created_by_id") @db.Uuid
  createdAt      DateTime     @map("created_at")
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade, map: "school_closures_year_fkey")

  @@index([academicYearId, startsOn], map: "school_closures_year_dates_idx")
  @@map("school_closures")
}

/// Falta ou atraso de um professor (aula ou dia), marcada pelo RH ou automática; justificar/anular fica na atividade.
model TeacherOccurrence {
  id            String    @id @db.Uuid
  employeeId    String    @map("employee_id") @db.Uuid
  day           DateTime  @db.Date
  /// LESSON | DAY
  scope         String
  lessonId      String?   @map("lesson_id") @db.Uuid
  groupName     String?   @map("group_name")
  subjectName   String?   @map("subject_name")
  startsAt      DateTime? @map("starts_at") @db.Time(6)
  endsAt        DateTime? @map("ends_at") @db.Time(6)
  /// FALTA | ATRASO
  kind          String
  minutesLate   Int?      @map("minutes_late")
  /// MANUAL | AUTOMATIC
  source        String
  /// REGISTADA | JUSTIFICADA | ANULADA
  status        String    @default("REGISTADA")
  note          String?
  justification String?
  createdById   String?   @map("created_by_id") @db.Uuid
  createdAt     DateTime  @map("created_at")
  updatedById   String?   @map("updated_by_id") @db.Uuid
  updatedAt     DateTime  @map("updated_at")

  @@index([day], map: "teacher_occurrences_day_idx")
  @@index([status, day], map: "teacher_occurrences_status_idx")
  @@map("teacher_occurrences")
}

/// A aula dada num dia (presenças submetidas). Cópia de turma/disciplina/professor/horas.
model LessonSession {
  id             String    @id @db.Uuid
  lessonId       String?   @map("lesson_id") @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  groupId        String    @map("group_id") @db.Uuid
  subjectId      String    @map("subject_id") @db.Uuid
  teacherId      String?   @map("teacher_id") @db.Uuid
  day            DateTime  @db.Date
  startsAt       DateTime  @map("starts_at") @db.Time(6)
  endsAt         DateTime  @map("ends_at") @db.Time(6)
  submittedAt    DateTime  @map("submitted_at")
  submittedById  String?   @map("submitted_by_id") @db.Uuid
  late           Boolean   @default(false)
  /// sumário da aula (o n.º da lição calcula-se ao ler)
  summary          String?
  summaryById      String?   @map("summary_by_id") @db.Uuid
  summaryUpdatedAt DateTime? @map("summary_updated_at")
  createdAt      DateTime  @map("created_at")
  updatedAt      DateTime  @map("updated_at")

  @@index([day], map: "lesson_sessions_day_idx")
  @@map("lesson_sessions")
}

/// Presença de um aluno numa aula: PRESENTE | AUSENTE | ATRASADO | FALTA_JUSTIFICADA.
model StudentAttendance {
  sessionId   String   @map("session_id") @db.Uuid
  studentId   String   @map("student_id") @db.Uuid
  status      String
  minutesLate Int?     @map("minutes_late")
  note        String?
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @map("updated_at")

  @@id([sessionId, studentId])
  @@map("student_attendance")
}

/// Caixa de notificações de um utilizador do portal (equipa).
model StaffNotification {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  kind      String
  title     String
  body      String?
  link      String?
  dedupeKey String?   @map("dedupe_key")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @map("created_at")

  @@map("staff_notifications")
}

/// Histórico de envios (equipa e família), por canal e estado.
model NotificationDelivery {
  id             String   @id @db.Uuid
  audience       String
  notificationId String?  @map("notification_id") @db.Uuid
  recipientId    String   @map("recipient_id") @db.Uuid
  recipientName  String?  @map("recipient_name")
  kind           String
  title          String
  channel        String
  destination    String?
  status         String
  error          String?
  createdAt      DateTime @map("created_at")

  @@map("notification_deliveries")
}

/// Tipos de notificação ligados/desligados pelo colégio (e se vão por email).
model NotificationType {
  kind        String   @id
  enabled     Boolean
  email       Boolean
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @map("updated_at")

  @@map("notification_types")
}

/// Preferência de email de cada pessoa da equipa por tipo.
model NotificationPreference {
  userId    String   @map("user_id") @db.Uuid
  kind      String
  email     Boolean
  updatedAt DateTime @map("updated_at")

  @@id([userId, kind])
  @@map("notification_preferences")
}

/// Um professor substitui outro numa aula, num dia.
model LessonSubstitution {
  id                String   @id @db.Uuid
  lessonId          String   @map("lesson_id") @db.Uuid
  day               DateTime @db.Date
  substituteId      String   @map("substitute_id") @db.Uuid
  originalTeacherId String?  @map("original_teacher_id") @db.Uuid
  reason            String?
  createdById       String?  @map("created_by_id") @db.Uuid
  createdAt         DateTime @map("created_at")

  @@unique([lessonId, day], map: "lesson_substitutions_lesson_day_key")
  @@map("lesson_substitutions")
}

/// Aula cujo prazo passou sem presenças (OPEN | SUBMITTED_LATE | FAULT | DISMISSED).
model LessonPending {
  id             String    @id @db.Uuid
  lessonId       String?   @map("lesson_id") @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  groupId        String    @map("group_id") @db.Uuid
  subjectId      String    @map("subject_id") @db.Uuid
  teacherId      String?   @map("teacher_id") @db.Uuid
  groupName      String    @map("group_name")
  subjectName    String    @map("subject_name")
  day            DateTime  @db.Date
  startsAt       DateTime  @map("starts_at") @db.Time(6)
  endsAt         DateTime  @map("ends_at") @db.Time(6)
  status         String    @default("OPEN")
  occurrenceId   String?   @map("occurrence_id") @db.Uuid
  reason         String?
  decidedById    String?   @map("decided_by_id") @db.Uuid
  decidedAt      DateTime? @map("decided_at")
  createdAt      DateTime  @map("created_at")

  @@map("lesson_pendings")
}

/// Execuções das tarefas automáticas (monitorização).
model JobRun {
  id         String    @id @db.Uuid
  job        String
  trigger    String
  status     String
  stats      Json?
  error      String?
  startedAt  DateTime  @map("started_at")
  finishedAt DateTime? @map("finished_at")

  @@map("job_runs")
}

/// Justificação de uma falta/atraso pelo professor (PENDING | APPROVED | REJECTED), com comprovativo cifrado opcional.
model OccurrenceJustification {
  id              String    @id @db.Uuid
  occurrenceId    String    @map("occurrence_id") @db.Uuid
  employeeId      String    @map("employee_id") @db.Uuid
  reason          String
  proofName       String?   @map("proof_name")
  proofMimeType   String?   @map("proof_mime_type")
  proofSize       Int?      @map("proof_size")
  proofSha256     String?   @map("proof_sha256")
  proofStorageKey String?   @map("proof_storage_key")
  status          String    @default("PENDING")
  decisionNote    String?   @map("decision_note")
  decidedById     String?   @map("decided_by_id") @db.Uuid
  decidedAt       DateTime? @map("decided_at")
  createdById     String?   @map("created_by_id") @db.Uuid
  createdAt       DateTime  @map("created_at")

  @@map("occurrence_justifications")
}

/// Alerta de assiduidade de um aluno (limite de faltas ou faltas seguidas), enviado uma vez por limite.
model AttendanceAlert {
  id        String   @id @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  groupId   String   @map("group_id") @db.Uuid
  /// ABSENCES | STREAK
  rule      String
  dedupeKey String   @map("dedupe_key")
  count     Int
  sessionId String?  @map("session_id") @db.Uuid
  createdAt DateTime @map("created_at")

  @@unique([studentId, dedupeKey], map: "attendance_alerts_key")
  @@index([groupId, createdAt], map: "attendance_alerts_group_idx")
  @@map("attendance_alerts")
}

/// Resumo diário de uma pessoa (STAFF: school_users; FAMILY: family_accounts) — um por dia.
model DailyDigest {
  id            String   @id @db.Uuid
  audience      String
  recipientId   String   @map("recipient_id") @db.Uuid
  recipientName String?  @map("recipient_name")
  day           DateTime @db.Date
  dueAt         DateTime @map("due_at") @db.Timestamp(0)
  headline      String
  content       Json
  /// NONE | PENDING | SENT | FAILED (só o email da família)
  emailState    String   @default("NONE") @map("email_state")
  emailAttempts Int      @default(0) @map("email_attempts")
  createdAt     DateTime @map("created_at")

  @@unique([audience, recipientId, day], map: "daily_digests_recipient_day_key")
  @@index([day], map: "daily_digests_day_idx")
  @@map("daily_digests")
}

/// Uma prova de um período de avaliação (época): datas, interrupção das aulas, publicação. (turmas e disciplinas: exam_season_groups/_subjects)
model ExamSeason {
  id             String    @id @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  periodPosition Int       @map("period_position")
  position       Int
  name           String
  startsOn       DateTime? @map("starts_on") @db.Date
  endsOn         DateTime? @map("ends_on") @db.Date
  /// A. com interrupção das aulas | B. sem
  interrupts     Boolean   @default(false)
  /// ESCRITA | ORAL | PRATICA | OUTRA (a habitual)
  format         String    @default("ESCRITA")
  notes          String?
  /// DRAFT | PUBLISHED
  status         String    @default("DRAFT")
  publishedAt    DateTime? @map("published_at")
  publishedById  String?   @map("published_by_id") @db.Uuid
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @map("created_at")
  updatedAt      DateTime  @map("updated_at")

  @@index([academicYearId, periodPosition, position], map: "exam_seasons_year_idx")
  @@map("exam_seasons")
}

model ExamSeasonGroup {
  seasonId String @map("season_id") @db.Uuid
  groupId  String @map("group_id") @db.Uuid

  @@id([seasonId, groupId])
  @@index([groupId], map: "exam_season_groups_group_idx")
  @@map("exam_season_groups")
}

model ExamSeasonSubject {
  seasonId  String @map("season_id") @db.Uuid
  classId   String @map("class_id") @db.Uuid
  subjectId String @map("subject_id") @db.Uuid

  @@id([seasonId, classId, subjectId])
  @@map("exam_season_subjects")
}

/// Uma prova marcada: turma + disciplina, dia e hora. Única por época + turma + disciplina + modalidade (índice parcial na BD).
model Exam {
  id           String   @id @db.Uuid
  seasonId     String   @map("season_id") @db.Uuid
  groupId      String   @map("group_id") @db.Uuid
  subjectId    String   @map("subject_id") @db.Uuid
  teacherId    String?  @map("teacher_id") @db.Uuid
  day          DateTime @db.Date
  startsAt     DateTime @map("starts_at") @db.Time(0)
  endsAt       DateTime @map("ends_at") @db.Time(0)
  room         String?
  format       String
  notes        String?
  /// SCHEDULED | CANCELLED
  status       String   @default("SCHEDULED")
  cancelReason String?  @map("cancel_reason")
  /// MANUAL | AUTOMATIC (da proposta automática, ainda não ajustada)
  source       String   @default("MANUAL")
  createdById  String?  @map("created_by_id") @db.Uuid
  createdAt    DateTime @map("created_at")
  updatedById  String?  @map("updated_by_id") @db.Uuid
  updatedAt    DateTime @map("updated_at")

  @@index([groupId, day], map: "exams_group_day_idx")
  @@index([teacherId, day], map: "exams_teacher_day_idx")
  @@map("exams")
}

/// Professor escalado para vigiar uma prova.
model ExamInvigilator {
  examId       String   @map("exam_id") @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  assignedById String?  @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime @map("assigned_at")

  @@id([examId, employeeId])
  @@index([employeeId], map: "exam_invigilators_employee_idx")
  @@map("exam_invigilators")
}

/// Avisos das provas por entregar (gravados com a alteração; entregues a seguir, retomados pelo ciclo automático).
model ExamNotice {
  id           String    @id @db.Uuid
  seasonId     String    @map("season_id") @db.Uuid
  groupIds     String[]  @map("group_ids") @db.Uuid
  subjectId    String?   @map("subject_id") @db.Uuid
  teacherIds   String[]  @default([]) @map("teacher_ids") @db.Uuid
  /// GENERAL | PUBLISHED | INVIGILATION
  kind         String    @default("GENERAL")
  title        String
  body         String
  createdAt    DateTime  @map("created_at")
  claimedAt    DateTime? @map("claimed_at")
  attempts     Int       @default(0)
  familySentAt DateTime? @map("family_sent_at")
  staffSentAt  DateTime? @map("staff_sent_at")
  error        String?

  @@map("exam_notices")
}

/// Preferência de email da conta da família, por tipo de notificação.
model FamilyNotificationPreference {
  accountId String   @map("account_id") @db.Uuid
  kind      String
  email     Boolean
  updatedAt DateTime @map("updated_at")

  @@id([accountId, kind])
  @@map("family_notification_preferences")
}

/// Configuração da assiduidade do colégio (uma linha).
model AttendanceSettings {
  id               Int      @id @default(1) @db.SmallInt
  /// PER_LESSON | PER_DAY
  teacherModel     String   @default("PER_LESSON") @map("teacher_model")
  /// MANUAL | AUTOMATIC
  missingProcedure String   @default("MANUAL") @map("missing_procedure")
  deadlineMinutes  Int      @default(60) @map("deadline_minutes")
  absenceLimit     Int      @default(10) @map("absence_limit")
  consecutiveLimit Int      @default(3) @map("consecutive_limit")
  timeZone         String   @default("Africa/Luanda") @map("time_zone")
  /// a partir de que dia o controlo automático do prazo conta
  trackingSince    DateTime @default(dbgenerated("CURRENT_DATE")) @map("tracking_since") @db.Date
  updatedById      String?  @map("updated_by_id") @db.Uuid
  updatedAt        DateTime @map("updated_at")

  @@map("attendance_settings")
}

// =============================================================================
//  SECRETARIA — inscrições e matrículas (configuração)
// =============================================================================

/// Períodos de inscrição, matrícula e renovação de um ano letivo (cada par: os dois ou nenhum).
model AdmissionPeriods {
  academicYearId   String       @id @map("academic_year_id") @db.Uuid
  academicYear     AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  applicationsFrom DateTime?    @map("applications_from") @db.Date
  applicationsTo   DateTime?    @map("applications_to") @db.Date
  enrollmentsFrom  DateTime?    @map("enrollments_from") @db.Date
  enrollmentsTo    DateTime?    @map("enrollments_to") @db.Date
  renewalsFrom     DateTime?    @map("renewals_from") @db.Date
  renewalsTo       DateTime?    @map("renewals_to") @db.Date
  updatedById      String?      @map("updated_by_id") @db.Uuid
  updatedAt        DateTime     @map("updated_at")

  @@map("admission_periods")
}

/// Modo de um dado fixo do aluno/encarregado que o colégio pode mudar (os campos vêm do código).
model AdmissionFixedField {
  /// STUDENT | GUARDIAN
  scope     String
  key       String
  /// REQUIRED | OPTIONAL | HIDDEN
  mode      String
  updatedAt DateTime @map("updated_at")

  @@id([scope, key])
  @@map("admission_fixed_fields")
}

/// Secção do formulário de inscrição definida pelo colégio.
model AdmissionFormSection {
  id           String               @id @db.Uuid
  title        String
  description  String?
  repeatable   Boolean              @default(false)
  entryLabel   String               @default("Registo") @map("entry_label")
  maxEntries   Int                  @default(1) @map("max_entries")
  processTypes String[]             @default([]) @map("process_types")
  position     Int
  active       Boolean              @default(true)
  createdAt    DateTime             @map("created_at")
  updatedAt    DateTime             @map("updated_at")
  fields       AdmissionFormField[]

  @@map("admission_form_sections")
}

/// Campo de uma secção (tipo, regras, processos e condição).
model AdmissionFormField {
  id           String               @id @db.Uuid
  sectionId    String               @map("section_id") @db.Uuid
  section      AdmissionFormSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  label        String
  type         String
  required     Boolean              @default(false)
  help         String?
  options      Json                 @default("[]")
  settings     Json                 @default("{}")
  processTypes String[]             @default([]) @map("process_types")
  condition    Json?
  position     Int
  active       Boolean              @default(true)
  createdAt    DateTime             @map("created_at")
  updatedAt    DateTime             @map("updated_at")

  @@index([sectionId, position], map: "admission_form_fields_section_idx")
  @@map("admission_form_fields")
}

/// Versão publicada dos formulários (fotografia em JSON).
model AdmissionFormVersion {
  id            String   @id @db.Uuid
  number        Int      @unique
  snapshot      Json
  publishedById String?  @map("published_by_id") @db.Uuid
  publishedAt   DateTime @map("published_at")

  @@map("admission_form_versions")
}

/// Documento pedido nas inscrições/matrículas: a quem (aluno, encarregado ou ambos), em que processos, formatos e regras.
model AdmissionDocumentType {
  id           String   @id @db.Uuid
  name         String
  description  String?
  required     Boolean  @default(false)
  /// STUDENT | GUARDIAN | BOTH
  target       String
  /// NOVA | RENOVACAO | TRANSFERENCIA | REINGRESSO (vazio = todos)
  processTypes String[] @default([]) @map("process_types")
  /// pdf, jpg, png, webp, doc, docx
  formats      String[]
  maxSizeMb    Int      @default(5) @map("max_size_mb")
  maxFiles     Int      @default(1) @map("max_files")
  /// pedir a data de validade do documento (ex.: atestado médico)
  needsExpiry  Boolean  @default(false) @map("needs_expiry")
  position     Int
  active       Boolean  @default(true)
  createdAt    DateTime @map("created_at")
  updatedAt    DateTime @map("updated_at")

  @@map("admission_document_types")
}

model SchoolClass {
  id             String       @id @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  /// 0 = Iniciação; 1–6 Primário; 7–9 I Ciclo; 10–13 II Ciclo
  grade          Int
  /// Obrigatório no II Ciclo (podem existir várias 10.ª, uma por curso)
  courseId       String?      @map("course_id") @db.Uuid
  course         Course?      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  description    String?
  /// Vagas para o ano letivo (direção). null = usar os lugares das turmas
  vacancies      Int?
  createdAt      DateTime     @map("created_at")

  groups       ClassGroup[]
  reservations SeatReservation[]
  subjects     ClassSubject[]
  fees         ClassFee[]
  applications Application[]
  enrollments  Enrollment[]

  @@index([courseId])
  @@map("school_classes")
}

/// Catálogo de cursos do colégio (atravessa os anos). GERAL: 10.ª–12.ª · TECNICO: 10.ª–13.ª
model Course {
  id          String    @id @db.Uuid
  name        String
  /// sigla (ex.: CFB)
  code        String?
  /// GERAL | TECNICO
  kind        String    @default("GERAL")
  description String?
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @map("created_at")
  updatedAt   DateTime  @map("updated_at")

  classes SchoolClass[]

  @@map("courses")
}

model ClassGroup {
  id             String       @id @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classId        String       @map("class_id") @db.Uuid
  schoolClass    SchoolClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  name           String
  /// MANHA | TARDE | NOITE
  shift          String
  room           String?
  capacity       Int?
  /// coordenador (diretor) de turma
  coordinatorId  String?      @map("coordinator_id") @db.Uuid
  coordinator    Employee?    @relation("GroupCoordinator", fields: [coordinatorId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @map("created_at")
  updatedAt      DateTime     @map("updated_at")

  reservations SeatReservation[]
  lessons      Lesson[]
  teachers     GroupTeacher[]
  enrollments  Enrollment[]

  @@index([academicYearId])
  @@map("class_groups")
}

/// Catálogo de disciplinas do colégio (atravessa os anos).
model Subject {
  id         String    @id @db.Uuid
  name       String
  /// sigla (ex.: MAT)
  code       String
  /// cor no horário (#rrggbb)
  color      String
  /// o que se estuda (mostrado às famílias no horário)
  description String?
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @map("created_at")
  updatedAt  DateTime  @map("updated_at")

  classes  ClassSubject[]
  lessons  Lesson[]
  teachers GroupTeacher[]

  @@map("subjects")
}

/// Habilitação de um professor: tipo de ensino → classes (e cursos no II Ciclo) → disciplinas.
model TeacherQualification {
  id         String   @id @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// pre | primario | ciclo1 | ciclo2
  level      String
  grades     Int[]
  courseIds  String[] @default([]) @map("course_ids") @db.Uuid
  subjectIds String[] @map("subject_ids") @db.Uuid
  createdAt  DateTime @map("created_at")
  updatedAt  DateTime @map("updated_at")

  @@index([employeeId])
  @@map("teacher_qualifications")
}

/// Assiduidade: um registo por funcionário e por dia (sem registo = por marcar).
model EmployeeAttendance {
  id              String    @id @db.Uuid
  employeeId      String    @map("employee_id") @db.Uuid
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  day             DateTime  @db.Date
  /// PRESENTE | ATRASO | FALTA | FALTA_JUSTIFICADA
  status          String
  minutesLate     Int?      @map("minutes_late")
  note            String?
  proofName       String?   @map("proof_name")
  proofMimeType   String?   @map("proof_mime_type")
  proofSize       Int?      @map("proof_size")
  proofSha256     String?   @map("proof_sha256")
  proofStorageKey String?   @map("proof_storage_key")
  proofUploadedAt DateTime? @map("proof_uploaded_at")
  recordedById    String?   @map("recorded_by_id") @db.Uuid
  createdAt       DateTime  @map("created_at")
  updatedAt       DateTime  @map("updated_at")

  @@unique([employeeId, day], map: "employee_attendance_employee_day_key")
  @@index([day], map: "employee_attendance_day_idx")
  @@map("employee_attendance")
}

/// Contrato de um funcionário (o estado calcula-se pelas datas). base_salary em kwanzas; null = por definir.
model EmployeeContract {
  id                String             @id @db.Uuid
  number            Int                @unique
  employeeId        String             @map("employee_id") @db.Uuid
  employee          Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// INDETERMINADO | DETERMINADO | PRESTACAO_SERVICOS | ESTAGIO
  kind              String
  /// TEMPO_INTEIRO | TEMPO_PARCIAL
  regime            String
  weeklyHours       Int                @map("weekly_hours")
  jobTitle          String             @map("job_title")
  department        String?
  startsOn          DateTime           @map("starts_on") @db.Date
  endsOn            DateTime?          @map("ends_on") @db.Date
  trialEndsOn       DateTime?          @map("trial_ends_on") @db.Date
  baseSalary        Int?               @map("base_salary")
  notes             String?
  previousId        String?            @map("previous_id") @db.Uuid
  previous          EmployeeContract?  @relation("ContractRenewal", fields: [previousId], references: [id], onDelete: SetNull)
  renewals          EmployeeContract[] @relation("ContractRenewal")
  terminatedOn      DateTime?          @map("terminated_on") @db.Date
  terminationReason String?            @map("termination_reason")
  fileName          String?            @map("file_name")
  fileMimeType      String?            @map("file_mime_type")
  fileSize          Int?               @map("file_size")
  fileSha256        String?            @map("file_sha256")
  fileStorageKey    String?            @map("file_storage_key")
  fileUploadedAt    DateTime?          @map("file_uploaded_at")
  createdById       String?            @map("created_by_id") @db.Uuid
  createdAt         DateTime           @map("created_at")
  updatedAt         DateTime           @map("updated_at")

  @@index([employeeId, startsOn], map: "employee_contracts_employee_idx")
  @@map("employee_contracts")
}

/// Quem dá cada disciplina em cada turma.
model GroupTeacher {
  groupId      String     @map("group_id") @db.Uuid
  group        ClassGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  subjectId    String     @map("subject_id") @db.Uuid
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  employeeId   String     @map("employee_id") @db.Uuid
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedById String?    @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime   @map("assigned_at")

  @@id([groupId, subjectId])
  @@index([employeeId])
  @@map("group_teachers")
}

/// Plano curricular: disciplina de uma classe (no ano) e tempos por semana.
model ClassSubject {
  id             String       @id @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classId        String       @map("class_id") @db.Uuid
  schoolClass    SchoolClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId      String       @map("subject_id") @db.Uuid
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  weeklyPeriods  Int          @map("weekly_periods")
  position       Int          @default(0)
  createdAt      DateTime     @map("created_at")

  @@unique([classId, subjectId])
  @@index([subjectId])
  @@map("class_subjects")
}

/// Tempos letivos de um turno (aula ou intervalo).
model SchoolPeriod {
  id        String   @id @db.Uuid
  /// MANHA | TARDE | NOITE
  shift     String
  position  Int
  startsAt  DateTime @map("starts_at") @db.Time(0)
  endsAt    DateTime @map("ends_at") @db.Time(0)
  /// AULA | INTERVALO
  kind      String   @default("AULA")
  createdAt DateTime @map("created_at")
  updatedAt DateTime @map("updated_at")

  lessons Lesson[]

  @@unique([shift, position])
  @@map("school_periods")
}

/// Horário: turma × dia × tempo → disciplina (+ sala, + professor quando existir).
model Lesson {
  id             String       @id @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  groupId        String       @map("group_id") @db.Uuid
  group          ClassGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// 1 = segunda … 5 = sexta
  weekday        Int
  periodId       String       @map("period_id") @db.Uuid
  period         SchoolPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  subjectId      String       @map("subject_id") @db.Uuid
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  /// professor da aula = o da disciplina nesta turma (mantido pela API)
  teacherId      String?      @map("teacher_id") @db.Uuid
  teacher        Employee?    @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  room           String?
  createdAt      DateTime     @map("created_at")
  updatedAt      DateTime     @map("updated_at")

  @@unique([groupId, weekday, periodId])
  @@index([subjectId])
  @@index([teacherId, weekday], map: "lessons_teacher_day_idx")
  @@map("lessons")
}

/// Ocupação de vagas: HELD (reservada, com prazo) → CONFIRMED (aluno numa turma) → RELEASED.
model SeatReservation {
  id             String       @id @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classId        String       @map("class_id") @db.Uuid
  schoolClass    SchoolClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  groupId        String?      @map("group_id") @db.Uuid
  group          ClassGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  /// HELD | CONFIRMED | RELEASED
  status         String
  /// quem ocupa (ex.: n.º da inscrição)
  reference      String
  expiresAt      DateTime?    @map("expires_at")
  /// inscrições com esta vaga guardada / matrículas que a ocupam
  applications   Application[] @relation("ApplicationSeat")
  enrollments    Enrollment[]
  createdAt      DateTime     @map("created_at")
  updatedAt      DateTime     @map("updated_at")

  @@index([classId, status])
  @@index([academicYearId, status])
  @@map("seat_reservations")
}

// =============================================================================
//  FINANÇAS — preçário (rubricas, preço por classe/curso, calendário das propinas)
// =============================================================================

/// Rubrica de cobrança (Propina, Matrícula, Confirmação, Uniforme…). Atravessa os anos.
model FeeItem {
  id         String    @id @db.Uuid
  name       String
  /// MENSAL | UNICA
  billing    String
  /// TODOS | NOVOS | CONTINUANTES
  appliesTo  String    @default("TODOS") @map("applies_to")
  /// quando se paga: INSCRICAO | MATRICULA (numa mensal: a 1.ª mensalidade) | DURANTE (o ano)
  chargedAt  String    @default("DURANTE") @map("charged_at")
  position   Int       @default(0)
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @map("created_at")
  updatedAt  DateTime  @map("updated_at")

  prices ClassFee[]

  @@map("fee_items")
}

/// Preço de uma rubrica numa classe do ano (no II Ciclo, a classe já é por curso). Kwanzas.
model ClassFee {
  id             String       @id @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classId        String       @map("class_id") @db.Uuid
  schoolClass    SchoolClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  feeItemId      String       @map("fee_item_id") @db.Uuid
  feeItem        FeeItem      @relation(fields: [feeItemId], references: [id], onDelete: Restrict)
  amount         Int
  updatedById    String?      @map("updated_by_id") @db.Uuid
  createdAt      DateTime     @map("created_at")
  updatedAt      DateTime     @map("updated_at")

  @@unique([classId, feeItemId])
  @@index([academicYearId])
  @@index([feeItemId])
  @@map("class_fees")
}

/// Calendário das propinas do ano: meses cobrados, dia limite e multa por atraso.
model FeePlan {
  academicYearId String       @id @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  /// ["2026-09", "2026-10", …]
  months         Json
  dueDay         Int          @default(10) @map("due_day")
  /// NONE | PERCENT | FIXED
  lateFeeKind    String       @default("NONE") @map("late_fee_kind")
  lateFeeValue   Int          @default(0) @map("late_fee_value")
  updatedById    String?      @map("updated_by_id") @db.Uuid
  createdAt      DateTime     @map("created_at")
  updatedAt      DateTime     @map("updated_at")

  @@map("fee_plans")
}

// =============================================================================
//  RECURSOS HUMANOS — configuração do cadastro de funcionários
// =============================================================================

/// Secção configurável do cadastro (ACADEMIC | PROFESSIONAL).
model HrFormSection {
  key         String   @id
  title       String
  description String?
  repeatable  Boolean  @default(false)
  entryLabel  String   @map("entry_label")
  maxEntries  Int      @default(10) @map("max_entries")
  position    Int
  updatedAt   DateTime @map("updated_at")

  fields HrFormField[]

  @@map("hr_form_sections")
}

/// Campo pedido numa secção (tipo, obrigatório, ajuda, opções, regras).
model HrFormField {
  id         String        @id @db.Uuid
  sectionKey String        @map("section")
  section    HrFormSection @relation(fields: [sectionKey], references: [key], onDelete: Restrict)
  label      String
  /// TEXT | LONG_TEXT | NUMBER | DATE | EMAIL | PHONE | SELECT | MULTI_SELECT | BOOLEAN | FILE
  type       String
  required   Boolean       @default(false)
  help       String?
  options    Json          @default("[]")
  settings   Json          @default("{}")
  position   Int
  active     Boolean       @default(true)
  /// tipos de funcionário a que se aplica (vazio = todos)
  employeeTypeIds String[] @default([]) @map("employee_type_ids") @db.Uuid
  createdAt  DateTime      @map("created_at")
  updatedAt  DateTime      @map("updated_at")

  @@index([sectionKey, position])
  @@map("hr_form_fields")
}

/// Tipo de funcionário (ex.: Docente, Administrativo, Auxiliar): define que campos e documentos lhe aparecem.
model HrEmployeeType {
  id          String   @id @db.Uuid
  name        String
  description String?
  /// papel no sistema de quem é deste tipo: PROFESSOR | RH | NONE (sem acesso ao portal)
  systemRole  String   @default("PROFESSOR") @map("system_role")
  position    Int
  active      Boolean  @default(true)
  createdAt   DateTime @map("created_at")
  updatedAt   DateTime @map("updated_at")

  requests  EmployeeRegistrationRequest[]
  invites   EmployeeRegistrationInvite[]
  employees Employee[]

  @@map("hr_employee_types")
}

/// Pedido de cadastro (página pública do colégio). PENDING → APPROVED | REJECTED | CANCELLED.
model EmployeeRegistrationRequest {
  id              String          @id @db.Uuid
  fullName        String          @map("full_name")
  email           String
  phone           String?
  passwordHash    String          @map("password_hash")
  employeeTypeId  String?         @map("employee_type_id") @db.Uuid
  employeeType    HrEmployeeType? @relation(fields: [employeeTypeId], references: [id], onDelete: SetNull)
  status          String          @default("PENDING")
  termsAcceptedAt DateTime        @map("terms_accepted_at")
  ip              String?
  userAgent       String?         @map("user_agent")
  decidedById     String?         @map("decided_by_id") @db.Uuid
  decidedAt       DateTime?       @map("decided_at")
  decisionReason  String?         @map("decision_reason")
  createdAt       DateTime        @map("created_at")
  updatedAt       DateTime        @map("updated_at")

  invites  EmployeeRegistrationInvite[]
  employee Employee?

  @@index([status, createdAt])
  @@map("employee_registration_requests")
}

/// Convite para o formulário: só o SHA-256 do token; validade; reenviar revoga o anterior.
model EmployeeRegistrationInvite {
  id             String                      @id @db.Uuid
  requestId      String                      @map("request_id") @db.Uuid
  request        EmployeeRegistrationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  tokenHash      String                      @unique @map("token_hash")
  employeeTypeId String?                     @map("employee_type_id") @db.Uuid
  employeeType   HrEmployeeType?             @relation(fields: [employeeTypeId], references: [id], onDelete: SetNull)
  expiresAt      DateTime                    @map("expires_at")
  sentAt         DateTime?                   @map("sent_at")
  sendError      String?                     @map("send_error")
  revokedAt      DateTime?                   @map("revoked_at")
  failedAttempts Int                         @default(0) @map("failed_attempts")
  lockedUntil    DateTime?                   @map("locked_until")
  lastUsedAt     DateTime?                   @map("last_used_at")
  createdById    String?                     @map("created_by_id") @db.Uuid
  createdAt      DateTime                    @map("created_at")
  /// sessão do formulário (SHA-256 do token; o token só existe no cookie do portal)
  sessionHash       String?                  @unique @map("session_hash")
  sessionExpiresAt  DateTime?                @map("session_expires_at")
  expiredNotifiedAt DateTime?                @map("expired_notified_at")

  @@map("employee_registration_invites")
}

/// Quem decidiu o quê (pedidos e cadastros): estado anterior, novo, justificação.
model EmployeeApprovalHistory {
  id          String   @id @db.Uuid
  subjectType String   @map("subject_type")
  subjectId   String   @map("subject_id") @db.Uuid
  fromStatus  String?  @map("from_status")
  toStatus    String   @map("to_status")
  actorId     String?  @map("actor_id") @db.Uuid
  actorName   String?  @map("actor_name")
  reason      String?
  createdAt   DateTime @map("created_at")

  @@index([subjectType, subjectId, createdAt])
  @@map("employee_approval_history")
}

/// Documento pedido aos funcionários.
model HrDocumentType {
  id          String   @id @db.Uuid
  name        String
  description String?
  required    Boolean  @default(false)
  /// pdf, jpg, png, webp, doc, docx
  formats     String[]
  maxSizeMb   Int      @default(5) @map("max_size_mb")
  multiple    Boolean  @default(false)
  position    Int
  active      Boolean  @default(true)
  /// tipos de funcionário a que se aplica (vazio = todos)
  employeeTypeIds String[] @default([]) @map("employee_type_ids") @db.Uuid
  createdAt   DateTime @map("created_at")
  updatedAt   DateTime @map("updated_at")

  @@map("hr_document_types")
}

/// Versão publicada da configuração (fotografia em JSON). Os cadastros ficam presos à sua versão.
model HrFormVersion {
  id            String   @id @db.Uuid
  number        Int      @unique
  snapshot      Json
  publishedById String?  @map("published_by_id") @db.Uuid
  publishedAt   DateTime @map("published_at")

  employees Employee[]

  @@map("hr_form_versions")
}

/// Cadastro de funcionário, preso à versão do formulário com que começou. Dados em JSONB validados pela API.
model Employee {
  id             String                       @id @db.Uuid
  number         Int?                         @unique
  requestId      String?                      @unique @map("request_id") @db.Uuid
  request        EmployeeRegistrationRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  employeeTypeId String?                      @map("employee_type_id") @db.Uuid
  employeeType   HrEmployeeType?              @relation(fields: [employeeTypeId], references: [id], onDelete: SetNull)
  formVersionId  String                       @map("form_version_id") @db.Uuid
  formVersion    HrFormVersion                @relation(fields: [formVersionId], references: [id], onDelete: Restrict)
  status         String                       @default("DRAFT")
  progress       String                       @default("NOT_STARTED")
  lastStep       String?                      @map("last_step")
  completedSteps String[]                     @default([]) @map("completed_steps")
  revision       Int                          @default(0)
  personal       Json                         @default("{}")
  sections       Json                         @default("{}")
  fullName       String                       @map("full_name")
  email          String?
  phone          String?
  jobTitle       String?                      @map("job_title")
  department     String?
  correctionNote String?                      @map("correction_note")
  createdById    String?                      @map("created_by_id") @db.Uuid
  submittedAt    DateTime?                    @map("submitted_at")
  approvedAt     DateTime?                    @map("approved_at")
  activatedAt    DateTime?                    @map("activated_at")
  terminatedAt   DateTime?                    @map("terminated_at")
  createdAt      DateTime                     @map("created_at")
  updatedAt      DateTime                     @map("updated_at")
  /// conta do portal (o RH dá acesso; ex.: o professor vê o seu horário)
  userId         String?                      @unique @map("user_id") @db.Uuid
  user           SchoolUser?                  @relation(fields: [userId], references: [id], onDelete: SetNull)

  documents      EmployeeDocument[]
  qualifications TeacherQualification[]
  contracts      EmployeeContract[]
  attendance     EmployeeAttendance[]
  teaching      GroupTeacher[]
  lessons       Lesson[]
  coordinatedOf ClassGroup[]                  @relation("GroupCoordinator")

  @@index([status, createdAt])
  @@index([employeeTypeId])
  @@map("employees")
}

/// Ficheiro entregue (conteúdo cifrado no armazenamento externo; aqui só a chave interna).
model EmployeeDocument {
  id           String   @id @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// PHOTO | DOCUMENT | FIELD
  slot         String
  itemId       String?  @map("item_id") @db.Uuid
  label        String
  fileName     String   @map("file_name")
  mimeType     String   @map("mime_type")
  size         Int
  sha256       String
  storageKey   String   @map("storage_key")
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @map("created_at")

  @@index([employeeId, slot, createdAt])
  @@map("employee_documents")
}

// =============================================================================
//  FAMÍLIAS — contas de família (separadas da equipa), alunos e encarregados
// =============================================================================

/// Conta de família (encarregado e/ou aluno maior): email + senha + código por email.
model FamilyAccount {
  id           String          @id @db.Uuid
  email        String          @unique
  fullName     String          @map("full_name")
  phone        String?
  passwordHash String          @map("password_hash")
  /// GUARDIAN (encarregado) | STUDENT (aluno maior de idade)
  kind         String          @default("GUARDIAN")
  /// obrigatória para STUDENT (o school-api confirma os 18 anos)
  birthDate    DateTime?       @map("birth_date") @db.Date
  /// PENDING | ACTIVE | SUSPENDED
  status       String          @default("PENDING")
  failedLogins Int             @default(0) @map("failed_logins")
  lockedUntil  DateTime?       @map("locked_until")
  lastLoginAt  DateTime?       @map("last_login_at")
  activatedAt  DateTime?       @map("activated_at")
  createdAt    DateTime        @map("created_at")
  updatedAt    DateTime        @map("updated_at")
  codes        FamilyCode[]
  sessions     FamilySession[]
  guardian     Guardian?
  student      Student?
  applications Application[]

  @@map("family_accounts")
}

model FamilyCode {
  id         String        @id @db.Uuid
  accountId  String        @map("account_id") @db.Uuid
  account    FamilyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// ACTIVATION | LOGIN | RECOVERY
  purpose    String
  codeHash   String        @map("code_hash")
  attempts   Int           @default(0)
  expiresAt  DateTime      @map("expires_at")
  consumedAt DateTime?     @map("consumed_at")
  createdAt  DateTime      @map("created_at")

  @@index([accountId, purpose, createdAt], map: "family_codes_account_idx")
  @@map("family_codes")
}

model FamilySession {
  id         String        @id @db.Uuid
  accountId  String        @map("account_id") @db.Uuid
  account    FamilyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ip         String?
  userAgent  String?       @map("user_agent")
  createdAt  DateTime      @map("created_at")
  lastSeenAt DateTime      @map("last_seen_at")
  expiresAt  DateTime      @map("expires_at")
  revokedAt  DateTime?     @map("revoked_at")

  @@index([accountId], map: "family_sessions_account_idx")
  @@map("family_sessions")
}

/// Encarregado de educação (pode não ter conta).
model Guardian {
  id        String            @id @db.Uuid
  accountId String?           @unique @map("account_id") @db.Uuid
  account   FamilyAccount?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  fullName  String            @map("full_name")
  email     String?
  phone     String?
  data      Json              @default("{}")
  createdAt DateTime          @map("created_at")
  updatedAt DateTime          @map("updated_at")
  students  StudentGuardian[]

  @@map("guardians")
}

/// Aluno (entidade académica). O maior de idade pode ser titular da sua conta.
model Student {
  id        String            @id @db.Uuid
  number    Int?              @unique
  accountId String?           @unique @map("account_id") @db.Uuid
  account   FamilyAccount?    @relation(fields: [accountId], references: [id], onDelete: SetNull)
  fullName  String            @map("full_name")
  birthDate DateTime          @map("birth_date") @db.Date
  gender    String?
  data      Json              @default("{}")
  /// CANDIDATE | ENROLLED | SUSPENDED | TRANSFERRED | LEFT | GRADUATED
  status    String            @default("CANDIDATE")
  createdAt DateTime          @map("created_at")
  updatedAt DateTime          @map("updated_at")
  guardians StudentGuardian[]
  applications Application[]
  enrollments Enrollment[]

  @@map("students")
}

/// Relação aluno ↔ encarregado (parentesco, principal, emergência, financeiro, se gere o aluno).
model StudentGuardian {
  studentId         String   @map("student_id") @db.Uuid
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardianId        String   @map("guardian_id") @db.Uuid
  guardian          Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  relationship      String
  relationshipOther String?  @map("relationship_other")
  isPrimary         Boolean  @default(false) @map("is_primary")
  isEmergency       Boolean  @default(false) @map("is_emergency")
  isFinancial       Boolean  @default(false) @map("is_financial")
  canManage         Boolean  @default(false) @map("can_manage")
  createdAt         DateTime @map("created_at")
  updatedAt         DateTime @map("updated_at")

  @@id([studentId, guardianId])
  @@index([guardianId], map: "student_guardians_guardian_idx")
  @@map("student_guardians")
}

/// Processo de inscrição (rascunho → submetido → análise…), feito por uma conta de família.
model Application {
  id                 String               @id @db.Uuid
  /// n.º do processo (na submissão)
  number             String?              @unique
  accountId          String               @map("account_id") @db.Uuid
  account            FamilyAccount        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  studentId          String?              @map("student_id") @db.Uuid
  student            Student?             @relation(fields: [studentId], references: [id], onDelete: SetNull)
  /// NOVA | RENOVACAO | TRANSFERENCIA | REINGRESSO
  processType        String               @map("process_type")
  formVersion        Int                  @map("form_version")
  academicYearId     String?              @map("academic_year_id") @db.Uuid
  academicYear       AcademicYear?        @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  classId            String?              @map("class_id") @db.Uuid
  schoolClass        SchoolClass?         @relation(fields: [classId], references: [id], onDelete: Restrict)
  /// MANHA | TARDE | NOITE (preferência)
  shift              String?
  studentData        Json                 @default("{}") @map("student_data")
  guardianData       Json                 @default("{}") @map("guardian_data")
  sectionsData       Json                 @default("{}") @map("sections_data")
  /// DRAFT | SUBMITTED | UNDER_REVIEW | CORRECTION_REQUIRED | APPROVED | REJECTED | CANCELLED
  status             String               @default("DRAFT")
  currentStep        String               @default("candidatura") @map("current_step")
  version            Int                  @default(1)
  termsAcceptedAt    DateTime?            @map("terms_accepted_at")
  legitimacyDeclared Boolean              @default(false) @map("legitimacy_declared")
  submittedAt        DateTime?            @map("submitted_at")
  createdAt          DateTime             @map("created_at")
  updatedAt          DateTime             @map("updated_at")
  seatReservationId  String?              @map("seat_reservation_id") @db.Uuid
  seatReservation    SeatReservation?     @relation("ApplicationSeat", fields: [seatReservationId], references: [id], onDelete: SetNull)
  enrollment         Enrollment?
  files              ApplicationFile[]
  history            ApplicationHistory[]

  @@index([accountId, createdAt], map: "applications_account_idx")
  @@index([academicYearId, status], map: "applications_year_status_idx")
  @@index([status, submittedAt], map: "applications_status_submitted_idx")
  @@map("applications")
}

/// Ficheiro de uma inscrição (conteúdo cifrado no armazenamento do colégio; aqui só a chave).
model ApplicationFile {
  id            String      @id @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  /// PHOTO | DOCUMENT | FIELD
  slot          String
  itemId        String?     @map("item_id")
  label         String
  fileName      String      @map("file_name")
  mimeType      String      @map("mime_type")
  size          Int
  sha256        String
  storageKey    String      @map("storage_key")
  createdAt     DateTime    @map("created_at")

  @@index([applicationId, slot, createdAt], map: "application_files_app_idx")
  @@map("application_files")
}

/// Histórico de estados de uma inscrição.
model ApplicationHistory {
  id            String      @id @db.Uuid
  applicationId String      @map("application_id") @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    String?     @map("from_status")
  toStatus      String      @map("to_status")
  /// FAMILY | STAFF
  actorKind     String      @map("actor_kind")
  actorId       String?     @map("actor_id") @db.Uuid
  actorName     String?     @map("actor_name")
  reason        String?
  notes         String?
  /// passos a corrigir (pedido de correções)
  steps         String[]    @default([])
  createdAt     DateTime    @map("created_at")

  @@index([applicationId, createdAt], map: "application_history_app_idx")
  @@map("application_history")
}

/// Configuração das matrículas do colégio (uma linha).
model AdmissionConfig {
  id             Int      @id @default(1) @db.SmallInt
  /// STAFF (secretaria) | FAMILY (a família confirma) | AUTO (ao aprovar)
  enrollmentMode String   @default("STAFF") @map("enrollment_mode")
  numberPrefix   String   @default("MAT") @map("number_prefix")
  numberWithYear Boolean  @default(true) @map("number_with_year")
  numberDigits   Int      @default(5) @map("number_digits")
  holdDays       Int      @default(15) @map("hold_days")
  updatedById    String?  @map("updated_by_id") @db.Uuid
  updatedAt      DateTime @map("updated_at")

  @@map("admission_config")
}

/// Último n.º de matrícula de cada ano letivo.
model EnrollmentCounter {
  academicYearId String       @id @map("academic_year_id") @db.Uuid
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  last           Int          @default(0)

  @@map("enrollment_counters")
}

/// Matrícula de um aluno num ano letivo (uma ativa por aluno e ano).
model Enrollment {
  id                String           @id @db.Uuid
  number            String           @unique
  studentId         String           @map("student_id") @db.Uuid
  student           Student          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  applicationId     String?          @unique @map("application_id") @db.Uuid
  application       Application?     @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  academicYearId    String           @map("academic_year_id") @db.Uuid
  academicYear      AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  classId           String           @map("class_id") @db.Uuid
  schoolClass       SchoolClass      @relation(fields: [classId], references: [id], onDelete: Restrict)
  groupId           String?          @map("group_id") @db.Uuid
  group             ClassGroup?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  shift             String?
  seatReservationId String?          @map("seat_reservation_id") @db.Uuid
  seatReservation   SeatReservation? @relation(fields: [seatReservationId], references: [id], onDelete: SetNull)
  /// ACTIVE | CANCELLED
  status            String           @default("ACTIVE")
  /// STAFF | FAMILY | AUTO
  byKind            String           @map("by_kind")
  byId              String?          @map("by_id") @db.Uuid
  byName            String?          @map("by_name")
  exceptionReason   String?          @map("exception_reason")
  enrolledAt        DateTime         @map("enrolled_at")
  createdAt         DateTime         @map("created_at")
  updatedAt         DateTime         @map("updated_at")

  @@index([academicYearId, classId], map: "enrollments_year_class_idx")
  @@map("enrollments")
}

/// Aviso dentro da área da família (correções pedidas, aprovada, matrícula confirmada…).
/// (as chaves estrangeiras estão na migração 0026; lê-se e escreve-se em SQL)
model FamilyNotification {
  id        String    @id @db.Uuid
  accountId String    @map("account_id") @db.Uuid
  kind      String
  title     String
  body      String?
  link      String?
  studentId String?   @map("student_id") @db.Uuid
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @map("created_at")

  @@index([accountId, createdAt], map: "family_notifications_account_idx")
  @@map("family_notifications")
}

/// O encarregado convida o educando que fez 18 anos a gerir a própria conta.
model StudentHandover {
  id          String    @id @db.Uuid
  studentId   String    @map("student_id") @db.Uuid
  email       String
  createdById String?   @map("created_by_id") @db.Uuid
  /// PENDING | DONE | CANCELLED
  status      String    @default("PENDING")
  accountId   String?   @map("account_id") @db.Uuid
  createdAt   DateTime  @map("created_at")
  completedAt DateTime? @map("completed_at")

  @@map("student_handovers")
}

/// Pagamentos (migração 0041): lê-se e escreve-se em SQL (finance/infrastructure/prisma-payments.ts),
/// onde estão também as chaves estrangeiras e as regras (CHECK, índices únicos parciais).
model PaymentSettings {
  id                Int       @id @default(1) @db.SmallInt
  transferEnabled   Boolean   @default(false) @map("transfer_enabled")
  activeSince       DateTime? @map("active_since")
  requireApplication Boolean  @default(true) @map("require_application")
  requireEnrollment Boolean   @default(true) @map("require_enrollment")
  /// AAAA-MM
  monthlyFrom       String?   @map("monthly_from")
  validationHours   Int       @default(48) @map("validation_hours")
  instructions      String?
  remindersEnabled  Boolean   @default(false) @map("reminders_enabled")
  remindBeforeDays  Int       @default(3) @map("remind_before_days")
  remindOnDue       Boolean   @default(true) @map("remind_on_due")
  remindEveryDays   Int       @default(7) @map("remind_every_days")
  remindMax         Int       @default(4) @map("remind_max")
  remindHour        Int       @default(9) @map("remind_hour")
  updatedById       String?   @map("updated_by_id") @db.Uuid
  updatedAt         DateTime  @map("updated_at")

  @@map("payment_settings")
}

/// Coordenadas bancárias do colégio.
model SchoolBankAccount {
  id            String   @id @db.Uuid
  bankName      String   @map("bank_name")
  holder        String
  accountNumber String?  @map("account_number")
  iban          String   @unique
  notes         String?
  active        Boolean  @default(true)
  position      Int      @default(0)
  createdAt     DateTime @map("created_at")
  updatedAt     DateTime @map("updated_at")

  @@map("bank_accounts")
}

/// Cobrança (inscrição, matrícula, propina do mês, outra).
model Charge {
  id             String    @id @db.Uuid
  /// INSCRICAO | MATRICULA | PROPINA | OUTRA
  kind           String
  label          String
  amount         Int
  academicYearId String    @map("academic_year_id") @db.Uuid
  studentId      String?   @map("student_id") @db.Uuid
  applicationId  String?   @map("application_id") @db.Uuid
  enrollmentId   String?   @map("enrollment_id") @db.Uuid
  feeItemId      String?   @map("fee_item_id") @db.Uuid
  month          String?
  dueOn          DateTime? @map("due_on") @db.Date
  /// OPEN | PAID | WAIVED | VOID
  status         String    @default("OPEN")
  paidAt         DateTime? @map("paid_at")
  waiveReason    String?   @map("waive_reason")
  decidedById    String?   @map("decided_by_id") @db.Uuid
  decidedAt      DateTime? @map("decided_at")
  createdAt      DateTime  @map("created_at")
  updatedAt      DateTime  @map("updated_at")

  @@index([studentId, status], map: "charges_student_idx")
  @@index([status, dueOn], map: "charges_status_idx")
  @@map("charges")
}

/// Pagamento por transferência ou depósito (só conta depois de VALIDATED).
model Payment {
  id                String    @id @db.Uuid
  number            Int       @unique(map: "payments_number_key") @default(autoincrement())
  accountId         String?   @map("account_id") @db.Uuid
  payerName         String    @map("payer_name")
  /// TRANSFERENCIA | DEPOSITO
  method            String
  bankAccountId     String?   @map("bank_account_id") @db.Uuid
  bankName          String    @map("bank_name")
  bankIban          String    @map("bank_iban")
  transactionNumber String    @map("transaction_number")
  paidOn            DateTime  @map("paid_on") @db.Date
  total             Int
  note              String?
  proofName         String    @map("proof_name")
  proofMimeType     String    @map("proof_mime_type")
  proofSize         Int       @map("proof_size")
  proofSha256       String    @map("proof_sha256")
  proofStorageKey   String    @map("proof_storage_key")
  /// SUBMITTED | VALIDATED | REJECTED | CANCELLED
  status            String    @default("SUBMITTED")
  /// FAMILY | STAFF
  createdByKind     String    @map("created_by_kind")
  createdById       String    @map("created_by_id") @db.Uuid
  submittedAt       DateTime  @map("submitted_at")
  dueAt             DateTime  @map("due_at")
  overdueNotifiedAt DateTime? @map("overdue_notified_at")
  decidedById       String?   @map("decided_by_id") @db.Uuid
  decidedAt         DateTime? @map("decided_at")
  decisionNote      String?   @map("decision_note")

  @@index([status, submittedAt], map: "payments_status_idx")
  @@index([accountId, submittedAt], map: "payments_account_idx")
  @@map("payments")
}

model PaymentItem {
  paymentId String @map("payment_id") @db.Uuid
  chargeId  String @map("charge_id") @db.Uuid
  label     String
  amount    Int
  lateFee   Int    @default(0) @map("late_fee")

  @@id([paymentId, chargeId])
  @@index([chargeId], map: "payment_items_charge_idx")
  @@map("payment_items")
}

/// Lembrete de uma cobrança enviado a uma conta da família (migração 0042).
model ChargeReminder {
  id        String   @id @db.Uuid
  chargeId  String   @map("charge_id") @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  /// BEFORE | DUE | AFTER | MANUAL
  stage     String
  day       DateTime @db.Date
  sentAt    DateTime @map("sent_at")
  byId      String?  @map("by_id") @db.Uuid

  @@unique([chargeId, accountId, day], map: "charge_reminders_key")
  @@map("charge_reminders")
}

model ExpenseCategory {
  id         String    @id @db.Uuid
  name       String
  position   Int       @default(0)
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @map("created_at")

  @@map("expense_categories")
}

/// Despesa do colégio (lê-se e escreve-se em SQL: finance/infrastructure/prisma-expenses.ts).
model Expense {
  id                String    @id @db.Uuid
  number            Int       @unique(map: "expenses_number_key") @default(autoincrement())
  categoryId        String    @map("category_id") @db.Uuid
  description       String
  supplier          String?
  documentNumber    String?   @map("document_number")
  amount            Int
  issuedOn          DateTime  @map("issued_on") @db.Date
  dueOn             DateTime? @map("due_on") @db.Date
  note              String?
  /// PENDING | PAID | CANCELLED
  status            String    @default("PENDING")
  paidOn            DateTime? @map("paid_on") @db.Date
  method            String?
  bankAccountId     String?   @map("bank_account_id") @db.Uuid
  bankName          String?   @map("bank_name")
  transactionNumber String?   @map("transaction_number")
  proofName         String?   @map("proof_name")
  proofMimeType     String?   @map("proof_mime_type")
  proofSize         Int?      @map("proof_size")
  proofSha256       String?   @map("proof_sha256")
  proofStorageKey   String?   @map("proof_storage_key")
  createdById       String?   @map("created_by_id") @db.Uuid
  createdAt         DateTime  @map("created_at")
  updatedAt         DateTime  @map("updated_at")
  paidById          String?   @map("paid_by_id") @db.Uuid
  cancelledById     String?   @map("cancelled_by_id") @db.Uuid
  cancelledAt       DateTime? @map("cancelled_at")
  cancelReason      String?   @map("cancel_reason")

  @@index([status, dueOn], map: "expenses_status_idx")
  @@index([paidOn], map: "expenses_paid_idx")
  @@map("expenses")
}

/// Critérios de avaliação (migração 0043): lê-se e escreve-se em SQL (grading/infrastructure/prisma-grading-settings.ts),
/// onde estão também as chaves estrangeiras e as regras (CHECK, índices únicos).
model GradingModel {
  id             String    @id @db.Uuid
  name           String
  description    String?
  draft          Json?
  currentVersion Int?      @map("current_version")
  revision       Int       @default(1)
  archivedAt     DateTime? @map("archived_at")
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @map("created_at")
  updatedById    String?   @map("updated_by_id") @db.Uuid
  updatedAt      DateTime  @map("updated_at")

  @@map("grading_models")
}

/// Uma versão publicada de um modelo: imutável.
model GradingModelVersion {
  id            String   @id @db.Uuid
  modelId       String   @map("model_id") @db.Uuid
  number        Int
  definition    Json
  reason        String?
  publishedById String?  @map("published_by_id") @db.Uuid
  publishedAt   DateTime @map("published_at")

  @@unique([modelId, number], map: "grading_model_versions_number_key")
  @@map("grading_model_versions")
}

/// Que modelo se aplica a quê num ano letivo (todo o colégio, ensino, curso ou classe; disciplina e período opcionais).
model GradingRule {
  id             String   @id @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  level          String?
  courseId       String?  @map("course_id") @db.Uuid
  classId        String?  @map("class_id") @db.Uuid
  subjectId      String?  @map("subject_id") @db.Uuid
  periodPosition Int?     @map("period_position")
  modelId        String   @map("model_id") @db.Uuid
  setById        String?  @map("set_by_id") @db.Uuid
  setAt          DateTime @map("set_at")

  @@index([modelId], map: "grading_rules_model_idx")
  @@map("grading_rules")
}

/// Elementos de avaliação do colégio (participação, testes, trabalhos…).
model GradingType {
  id         String    @id @db.Uuid
  name       String
  position   Int
  archivedAt DateTime? @map("archived_at")
  createdAt  DateTime  @map("created_at")

  @@map("grading_types")
}

/// Caderneta: uma avaliação de uma turma, disciplina e período, num componente do modelo (lê-se e escreve-se em SQL).
model GradingAssessment {
  id             String    @id @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  groupId        String    @map("group_id") @db.Uuid
  subjectId      String    @map("subject_id") @db.Uuid
  periodPosition Int       @map("period_position")
  componentKey   String    @map("component_key")
  typeId         String?   @map("type_id") @db.Uuid
  name           String
  heldOn         DateTime? @map("held_on") @db.Date
  outOf          Decimal?  @map("out_of") @db.Decimal(7, 2)
  weight         Decimal?  @db.Decimal(5, 2)
  revision       Int       @default(1)
  /// a prova do calendário que esta avaliação regista (única; SET NULL se a prova for retirada)
  examId         String?   @map("exam_id") @db.Uuid
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @map("created_at")
  updatedById    String?   @map("updated_by_id") @db.Uuid
  updatedAt      DateTime  @map("updated_at")

  @@index([groupId, subjectId, periodPosition], map: "grading_assessments_book_idx")
  @@index([academicYearId], map: "grading_assessments_year_idx")
  @@map("grading_assessments")
}

/// A nota de um aluno numa avaliação (sem linha = por lançar).
model GradingMark {
  assessmentId String   @map("assessment_id") @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  /// GRADED | ABSENT | ABSENT_JUSTIFIED | EXEMPT
  state        String
  score        Decimal? @db.Decimal(7, 2)
  note         String?
  updatedById  String?  @map("updated_by_id") @db.Uuid
  updatedAt    DateTime @map("updated_at")

  @@id([assessmentId, studentId])
  @@index([studentId], map: "grading_marks_student_idx")
  @@map("grading_marks")
}

/// Menção (modelos qualitativos) e apreciação do professor, por aluno, disciplina e período.
model GradingPeriodNote {
  academicYearId String   @map("academic_year_id") @db.Uuid
  groupId        String   @map("group_id") @db.Uuid
  subjectId      String   @map("subject_id") @db.Uuid
  periodPosition Int      @map("period_position")
  studentId      String   @map("student_id") @db.Uuid
  levelKey       String?  @map("level_key")
  comment        String?
  updatedById    String?  @map("updated_by_id") @db.Uuid
  updatedAt      DateTime @map("updated_at")

  @@id([groupId, subjectId, periodPosition, studentId])
  @@map("grading_period_notes")
}

/// Estado das classificações de uma disciplina numa turma e período (sem linha = em preparação). Lê-se e escreve-se em SQL.
model GradingTerm {
  academicYearId String    @map("academic_year_id") @db.Uuid
  groupId        String    @map("group_id") @db.Uuid
  subjectId      String    @map("subject_id") @db.Uuid
  periodPosition Int       @map("period_position")
  /// RETURNED | SUBMITTED | VALIDATED | PUBLISHED | REOPENED
  status         String
  revision       Int       @default(1)
  modelId        String?   @map("model_id") @db.Uuid
  modelVersion   Int?      @map("model_version")
  results        Json?
  publications   Int       @default(0)
  note           String?
  submittedAt    DateTime? @map("submitted_at")
  submittedById  String?   @map("submitted_by_id") @db.Uuid
  validatedAt    DateTime? @map("validated_at")
  validatedById  String?   @map("validated_by_id") @db.Uuid
  publishedAt    DateTime? @map("published_at")
  publishedById  String?   @map("published_by_id") @db.Uuid
  updatedAt      DateTime  @map("updated_at")

  @@id([groupId, subjectId, periodPosition])
  @@index([academicYearId, periodPosition, status], map: "grading_terms_year_idx")
  @@map("grading_terms")
}

/// Cada publicação das classificações, tal como foi (só de acrescentar): o que as famílias veem.
model GradingPublication {
  id              String   @id @db.Uuid
  academicYearId  String   @map("academic_year_id") @db.Uuid
  groupId         String   @map("group_id") @db.Uuid
  subjectId       String   @map("subject_id") @db.Uuid
  periodPosition  Int      @map("period_position")
  number          Int
  modelId         String?  @map("model_id") @db.Uuid
  modelVersion    Int?     @map("model_version")
  results         Json
  reason          String?
  publishedById   String?  @map("published_by_id") @db.Uuid
  publishedByName String?  @map("published_by_name")
  publishedAt     DateTime @map("published_at")

  @@unique([groupId, subjectId, periodPosition, number], map: "grading_publications_number_key")
  @@map("grading_publications")
}

/// Regras de transição do colégio, por ensino (sem regras: o resultado do aluno fica por decidir).
model GradingProgression {
  /// pre | primario | ciclo1 | ciclo2
  level            String   @id
  maxNegatives     Int?     @map("max_negatives")
  coreSubjectIds   String[] @default([]) @map("core_subject_ids") @db.Uuid
  maxCoreNegatives Int?     @map("max_core_negatives")
  updatedById      String?  @map("updated_by_id") @db.Uuid
  updatedAt        DateTime @map("updated_at")

  @@map("grading_progression")
}

/// "Final do ano" de um aluno numa disciplina: exame (e provas do exame) e prova de recuperação.
model GradingFinalMark {
  academicYearId String   @map("academic_year_id") @db.Uuid
  groupId        String   @map("group_id") @db.Uuid
  subjectId      String   @map("subject_id") @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  /// GRADED | ABSENT | ABSENT_JUSTIFIED
  examState      String?  @map("exam_state")
  examValue      Decimal? @map("exam_value") @db.Decimal(7, 2)
  examParts      Json?    @map("exam_parts")
  recoveryValue  Decimal? @map("recovery_value") @db.Decimal(7, 2)
  updatedById    String?  @map("updated_by_id") @db.Uuid
  updatedAt      DateTime @map("updated_at")

  @@id([groupId, subjectId, studentId])
  @@map("grading_final_marks")
}

/// Deliberação da direção sobre o resultado do ano de um aluno (muda o calculado; sempre com motivo).
model GradingYearDecision {
  academicYearId String   @map("academic_year_id") @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  groupId        String   @map("group_id") @db.Uuid
  /// PASSED | RETAINED
  outcome        String
  reason         String
  decidedById    String?  @map("decided_by_id") @db.Uuid
  decidedByName  String?  @map("decided_by_name")
  decidedAt      DateTime @map("decided_at")

  @@id([academicYearId, studentId])
  @@map("grading_year_decisions")
}

/// O resultado do ano calculado de cada aluno (guardado: a renovação lê-o sem refazer as contas).
model GradingYearResult {
  academicYearId String   @map("academic_year_id") @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  groupId        String   @map("group_id") @db.Uuid
  /// PASSED | RETAINED | RECOVERY | UNDECIDED
  computed       String
  negatives      Int      @default(0)
  details        Json     @default("{}")
  updatedAt      DateTime @map("updated_at")

  @@id([academicYearId, studentId])
  @@map("grading_year_results")
}

/// Histórico da caderneta, só de acrescentar (um trigger impede alterar ou apagar).
model GradingChange {
  id             String   @id @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  groupId        String   @map("group_id") @db.Uuid
  subjectId      String   @map("subject_id") @db.Uuid
  periodPosition Int      @map("period_position")
  assessmentId   String?  @map("assessment_id") @db.Uuid
  studentId      String?  @map("student_id") @db.Uuid
  kind           String
  before         Json?
  after          Json?
  reason         String?
  byId           String?  @map("by_id") @db.Uuid
  byName         String?  @map("by_name")
  at             DateTime

  @@index([groupId, subjectId, periodPosition, at(sort: Desc)], map: "grading_changes_book_idx")
  @@index([studentId, at(sort: Desc)], map: "grading_changes_student_idx")
  @@map("grading_changes")
}

// =============================================================================
// DOCUMENTOS — pedidos, emissão e levantamento (usados por SQL; ver 0048_documents)
// =============================================================================

/// Um tipo de documento que se pode pedir (alunos: secretaria/pedagogia; funcionários: RH).
model DocumentType {
  id               String   @id @db.Uuid
  /// STUDENT | EMPLOYEE
  audience         String
  /// SECRETARIA | PEDAGOGIA | RH
  department       String
  category         String
  name             String
  description      String?
  requirements     String?
  /// AUTO | EXTERNAL
  method           String   @default("EXTERNAL")
  pickup           Boolean  @default(true)
  download         Boolean  @default(false)
  fee              Int?
  slaDays          Int      @default(3) @map("sla_days")
  requiresApproval Boolean  @default(false) @map("requires_approval")
  fields           Json     @default("[]")
  active           Boolean  @default(true)
  position         Int      @default(0)
  createdById      String?  @map("created_by_id") @db.Uuid
  createdAt        DateTime @map("created_at")
  updatedAt        DateTime @map("updated_at")

  @@map("document_types")
}

/// Um pedido de documento (DOC-<ano>-<n.º>), com a cópia do tipo e do beneficiário.
model DocumentRequest {
  id                 String    @id @db.Uuid
  number             Int       @unique(map: "document_requests_number_key") @default(autoincrement())
  year               Int
  typeId             String    @map("type_id") @db.Uuid
  typeName           String    @map("type_name")
  category           String
  audience           String
  department         String
  method             String
  pickup             Boolean
  download           Boolean
  requiresApproval   Boolean   @map("requires_approval")
  fee                Int?
  studentId          String?   @map("student_id") @db.Uuid
  employeeId         String?   @map("employee_id") @db.Uuid
  beneficiary        Json
  requesterKind      String    @map("requester_kind")
  requesterAccountId String?   @map("requester_account_id") @db.Uuid
  requesterUserId    String?   @map("requester_user_id") @db.Uuid
  requesterName      String    @map("requester_name")
  relationship       String
  answers            Json      @default("{}")
  notes              String?
  /// PENDING | IN_REVIEW | AWAITING_PAYMENT | PROCESSING | READY_PICKUP | READY_DOWNLOAD | COMPLETED | REJECTED | CANCELLED
  status             String    @default("PENDING")
  revision           Int       @default(1)
  dueOn              DateTime? @map("due_on") @db.Date
  rejectReason       String?   @map("reject_reason")
  cancelReason       String?   @map("cancel_reason")
  handledById        String?   @map("handled_by_id") @db.Uuid
  handledByName      String?   @map("handled_by_name")
  createdAt          DateTime  @map("created_at")
  updatedAt          DateTime  @map("updated_at")
  completedAt        DateTime? @map("completed_at")

  @@index([studentId, createdAt(sort: Desc)], map: "document_requests_student_idx")
  @@index([employeeId, createdAt(sort: Desc)], map: "document_requests_employee_idx")
  @@index([typeId], map: "document_requests_type_idx")
  @@map("document_requests")
}

/// Cada passo e cada nota de um pedido (só de acrescentar).
model DocumentRequestEvent {
  id         String   @id @db.Uuid
  requestId  String   @map("request_id") @db.Uuid
  kind       String
  fromStatus String?  @map("from_status")
  toStatus   String?  @map("to_status")
  note       String?
  internal   Boolean  @default(false)
  actorKind  String   @map("actor_kind")
  actorId    String?  @map("actor_id") @db.Uuid
  actorName  String?  @map("actor_name")
  at         DateTime

  @@index([requestId, at], map: "document_request_events_request_idx")
  @@map("document_request_events")
}

/// A entrega de um documento físico: quem recebeu, a relação com o beneficiário e quem entregou.
model DocumentDelivery {
  id                 String   @id @db.Uuid
  requestId          String   @unique(map: "document_deliveries_request_key") @map("request_id") @db.Uuid
  receivedBy         String   @map("received_by")
  receivedByDocument String?  @map("received_by_document")
  relationship       String
  deliveredById      String?  @map("delivered_by_id") @db.Uuid
  deliveredByName    String?  @map("delivered_by_name")
  deliveredAt        DateTime @map("delivered_at")
  notes              String?

  @@map("document_deliveries")
}

