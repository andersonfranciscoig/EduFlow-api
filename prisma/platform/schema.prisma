// =============================================================================
//  EduFlow — Base de dados da PLATAFORMA (Módulo 1)
//  Contém apenas dados da empresa: equipa interna, clientes (colégios), planos…
//  Os dados de cada colégio vivem numa base de dados própria (Módulo 2).
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/platform-client"
}

// O CLI (migrações) liga-se como "migrator". As apps ligam-se cada uma com o
// seu próprio utilizador de privilégios mínimos (URL passado em runtime).
datasource db {
  provider = "postgresql"
  url      = env("PLATFORM_MIGRATOR_URL")
}

enum StaffRole {
  ADMIN
  GESTOR
}

enum StaffStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
}

model StaffMember {
  id                  String      @id @db.Uuid
  fullName            String      @map("full_name")
  email               String?     @unique
  phone               String?     @unique
  passwordHash        String      @map("password_hash")
  role                StaffRole
  status              StaffStatus
  /// Permissões atribuídas individualmente (além das do papel)
  extraPermissions    String[]    @default([]) @map("extra_permissions")
  failedLoginAttempts Int         @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?   @map("locked_until")
  lastLoginAt         DateTime?   @map("last_login_at")

  /// 2FA (TOTP). Segredos cifrados com AES-256-GCM (chave só no platform-api).
  mfaSecretCiphertext        String?   @map("mfa_secret_ciphertext")
  mfaPendingSecretCiphertext String?   @map("mfa_pending_secret_ciphertext")
  mfaEnabledAt               DateTime? @map("mfa_enabled_at")
  /// Último intervalo TOTP aceite — impede reutilizar o mesmo código.
  mfaLastUsedStep            Int?      @map("mfa_last_used_step")
  /// Hashes SHA-256 dos códigos de recuperação ainda por usar.
  mfaRecoveryCodeHashes      String[]  @default([]) @map("mfa_recovery_code_hashes")

  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  activities      StaffActivity[] @relation("ActivitySubject")
  actedActivities StaffActivity[] @relation("ActivityActor")
  sessions        StaffSession[]

  @@map("staff_members")
}

/// Sessões da equipa: cada login cria uma; os tokens só valem enquanto a
/// sessão estiver ativa (revogável a qualquer momento).
model StaffSession {
  id            String      @id @db.Uuid
  staffId       String      @map("staff_id") @db.Uuid
  staff         StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  ip            String?
  userAgent     String?     @map("user_agent")
  createdAt     DateTime    @default(now()) @map("created_at")
  lastSeenAt    DateTime    @map("last_seen_at")
  expiresAt     DateTime    @map("expires_at")
  /// Última verificação 2FA (login ou confirmação de ação sensível).
  mfaVerifiedAt DateTime    @map("mfa_verified_at")
  revokedAt     DateTime?   @map("revoked_at")
  revokedReason String?     @map("revoked_reason")

  @@index([staffId, revokedAt])
  @@map("staff_sessions")
}

/// Convites para a equipa: só quem for convidado (por email) pode criar conta.
/// O token do link só existe no email; aqui fica o hash.
model StaffInvitation {
  id          String    @id @db.Uuid
  email       String
  role        StaffRole
  tokenHash   String    @unique @map("token_hash")
  invitedById String    @map("invited_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("staff_invitations")
}

/// Histórico de atividade da equipa (eventos de domínio do StaffMember).
model StaffActivity {
  id         String       @id @db.Uuid
  type       String
  subjectId  String       @map("subject_id") @db.Uuid
  subject    StaffMember  @relation("ActivitySubject", fields: [subjectId], references: [id], onDelete: Cascade)
  actorId    String?      @map("actor_id") @db.Uuid
  actor      StaffMember? @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  details    Json?
  occurredAt DateTime     @map("occurred_at")

  @@index([subjectId, occurredAt(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
  @@map("staff_activity")
}

// =============================================================================
//  FATURAÇÃO — planos, definições, contas bancárias
//  Valores monetários em Kwanzas (AOA), inteiros.
// =============================================================================

model Plan {
  id           String   @id @db.Uuid
  code         String   @unique
  name         String
  description  String
  monthlyPrice Int      @map("monthly_price")
  maxStudents  Int?     @map("max_students")
  features     String[] @default([])
  active       Boolean  @default(true)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("plans")
}

/// Linha única (id = 1) com as definições de faturação.
model BillingSettings {
  id                    Int      @id @default(1)
  quarterlyDiscountPct  Int      @map("quarterly_discount_pct")
  annualDiscountPct     Int      @map("annual_discount_pct")
  referenceEntity       String   @map("reference_entity")
  referenceProvider     String   @map("reference_provider")
  referenceValidityDays Int      @map("reference_validity_days")
  transferInstructions  String?  @map("transfer_instructions")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("billing_settings")
}

model BankAccount {
  id        String   @id @db.Uuid
  bankName  String   @map("bank_name")
  holder    String
  iban      String   @unique
  swift     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("bank_accounts")
}

// =============================================================================
//  COLÉGIOS (clientes) — registo, subscrição e ciclo de pagamento
// =============================================================================

enum SchoolStatus {
  PENDING_REVIEW
  AWAITING_PAYMENT
  PAYMENT_UNDER_REVIEW
  ACTIVE
  REJECTED
  /// Desativado pela equipa ou por não ter passado a email corporativo no prazo
  SUSPENDED
}

enum OrderStatus {
  PENDING_REVIEW
  AWAITING_PAYMENT
  PROOF_SUBMITTED
  PAID
  CANCELLED
}

enum PaymentMethod {
  REFERENCE
  TRANSFER
}

model School {
  id                 String       @id @db.Uuid
  /// Identificador público (subdomínio do portal do colégio)
  slug               String?      @unique
  name               String
  nif                String       @unique
  phone              String
  province           String
  municipality       String
  address            String
  ownerName          String       @map("owner_name")
  ownerEmail         String       @unique @map("owner_email")
  ownerPasswordHash  String       @map("owner_password_hash")
  status             SchoolStatus
  rejectionReason    String?      @map("rejection_reason")
  subscriptionEndsAt DateTime?    @map("subscription_ends_at")
  /// Email pessoal: prazo para passar a corporativo (null = já é corporativo)
  ownerEmailDeadline  DateTime?     @map("owner_email_deadline")
  suspendedAt         DateTime?     @map("suspended_at")
  suspensionReason    String?       @map("suspension_reason")
  suspendedFromStatus SchoolStatus? @map("suspended_from_status")
  /// Logótipo (público): chave no armazenamento + URL. O school-api só lê o URL.
  logoKey             String?       @map("logo_key")
  logoUrl             String?       @map("logo_url")
  logoUpdatedAt       DateTime?     @map("logo_updated_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  orders     SubscriptionOrder[]
  activities SchoolActivity[]
  provisioning TenantProvisioningJob?
  database     TenantDatabase?
  allocations  DatabaseAllocation[]
  backups      DatabaseBackup[]
  restores     DatabaseRestore[]

  @@index([status])
  @@map("schools")
}

// =============================================================================
//  PROVISIONAMENTO — base de dados própria de cada colégio
// =============================================================================

enum ProvisioningStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

/// Outbox: escrito pela plataforma (na mesma transação da ativação) e
/// processado pelo "provisioner". Leva consigo o que o provisioner precisa,
/// para que este não tenha acesso à tabela de colégios.
model TenantProvisioningJob {
  id         String             @id @db.Uuid
  schoolId   String             @unique @map("school_id") @db.Uuid
  school     School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  slug       String
  schoolName String             @map("school_name")
  /// Responsável: o provisioner cria-lhe a conta (por ativar) na BD do colégio.
  /// Copiado aqui para o provisioner não precisar de ler a tabela schools.
  ownerName  String?            @map("owner_name")
  ownerEmail String?            @map("owner_email")
  /// Primeira vez que a BD ficou pronta. Depois disto, voltar a PENDING só
  /// atualiza (migrações) — nunca se pode mudar o colégio de servidor por aqui.
  provisionedAt DateTime?       @map("provisioned_at")
  /// Servidor onde criar a BD. NULL = ainda sem servidor atribuído (à espera).
  serverId   String?            @map("server_id") @db.Uuid
  server     DatabaseServer?    @relation(fields: [serverId], references: [id], onDelete: Restrict)
  status     ProvisioningStatus @default(PENDING)
  attempts   Int                @default(0)
  lastError  String?            @map("last_error")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("tenant_provisioning_jobs")
}

/// Diretório de colégios — a ÚNICA tabela da plataforma que o school-api lê.
/// A senha da BD do colégio está cifrada com a chave pública do school-api.
model TenantDatabase {
  schoolId           String   @id @map("school_id") @db.Uuid
  school             School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  slug               String   @unique
  schoolName         String   @map("school_name")
  dbHost             String   @map("db_host")
  dbPort             Int      @map("db_port")
  dbName             String   @map("db_name")
  dbUser             String   @map("db_user")
  passwordCiphertext String   @map("password_ciphertext")
  /// disable | require | verify-ca | verify-full
  sslMode            String   @default("disable") @map("ssl_mode")
  serverId           String?  @map("server_id") @db.Uuid
  /// Quantidade de dados da BD do colégio (medida pelo provisioner)
  sizeBytes          BigInt?  @map("size_bytes")
  sizeMeasuredAt     DateTime? @map("size_measured_at")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([dbHost, dbPort, dbName])
  @@map("tenant_databases")
}

// =============================================================================
//  SERVIDORES DE BASES DE DADOS — onde vivem as BDs dos colégios
//  O URL de ligação é cifrado com a chave PÚBLICA do provisioner e guardado
//  numa tabela à parte, onde a plataforma pode escrever mas NÃO ler.
// =============================================================================

enum DatabaseServerKind {
  /// Servidor PostgreSQL onde o provisioner cria uma BD por colégio
  SHARED_SERVER
  /// Uma BD já criada, dedicada a um único colégio
  DEDICATED_DATABASE
}

enum DatabaseServerStatus {
  ACTIVE
  DISABLED
}

enum DatabaseServerHealth {
  UNKNOWN
  HEALTHY
  DEGRADED
  UNREACHABLE
}

enum DatabaseCheckKind {
  REGISTRATION
  MANUAL
  PERIODIC
}

enum DatabaseCheckStatus {
  PENDING
  RUNNING
  DONE
}

enum DatabaseAllocationStatus {
  /// Reservada na validação do colégio (tem prazo)
  RESERVED
  /// Atribuída após o pagamento — a BD do colégio vive aqui
  ASSIGNED
  RELEASED
  EXPIRED
}

model DatabaseServer {
  id       String               @id @db.Uuid
  name     String
  kind     DatabaseServerKind
  status   DatabaseServerStatus @default(ACTIVE)
  region   String?
  notes    String?
  /// Dados NÃO secretos extraídos do URL (para mostrar e evitar duplicados)
  host     String
  port     Int
  database String
  username String
  sslMode  String               @map("ssl_mode")
  /// user@host:port/database — único
  endpoint String               @unique
  /// Nº máximo de colégios (dedicada = 1)
  capacity Int

  /// Escrito apenas pelo provisioner
  health              DatabaseServerHealth @default(UNKNOWN)
  lastCheckedAt       DateTime?            @map("last_checked_at")
  lastLatencyMs       Int?                 @map("last_latency_ms")
  serverVersion       String?              @map("server_version")
  tlsActive           Boolean?             @map("tls_active")
  lastError           String?              @map("last_error")
  consecutiveFailures Int                  @default(0) @map("consecutive_failures")
  /// Soma dos dados das BDs dos colégios neste servidor (provisioner)
  usedBytes           BigInt?              @map("used_bytes")

  credentialsUpdatedAt DateTime @map("credentials_updated_at")
  createdById          String?  @map("created_by_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  secret      DatabaseServerSecret?
  checks      DatabaseServerCheck[]
  allocations DatabaseAllocation[]
  activities  DatabaseServerActivity[]
  jobs        TenantProvisioningJob[]

  @@index([status, kind])
  @@map("database_servers")
}

/// URL de ligação cifrado (envelope RSA-OAEP + AES-256-GCM). Só o provisioner
/// tem a chave privada; a plataforma tem INSERT/UPDATE mas não SELECT.
model DatabaseServerSecret {
  serverId      String         @id @map("server_id") @db.Uuid
  server        DatabaseServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  urlCiphertext String         @map("url_ciphertext")
  updatedAt     DateTime       @default(now()) @map("updated_at")

  @@map("database_server_secrets")
}

/// Testes de ligação: pedidos pela equipa (fila) ou periódicos (provisioner).
model DatabaseServerCheck {
  id            String              @id @db.Uuid
  serverId      String              @map("server_id") @db.Uuid
  server        DatabaseServer      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  kind          DatabaseCheckKind
  status        DatabaseCheckStatus @default(PENDING)
  requestedById String?             @map("requested_by_id") @db.Uuid
  ok            Boolean?
  connectMs     Int?                @map("connect_ms")
  latencyMs     Int?                @map("latency_ms")
  serverVersion String?             @map("server_version")
  tls           Boolean?
  /// Permissões, nº de BDs, avisos…
  details       Json?
  error         String?
  createdAt     DateTime            @default(now()) @map("created_at")
  completedAt   DateTime?           @map("completed_at")

  @@index([serverId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("database_server_checks")
}

model DatabaseAllocation {
  id            String                   @id @db.Uuid
  serverId      String                   @map("server_id") @db.Uuid
  server        DatabaseServer           @relation(fields: [serverId], references: [id], onDelete: Restrict)
  schoolId      String                   @map("school_id") @db.Uuid
  school        School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  status        DatabaseAllocationStatus
  reservedAt    DateTime                 @map("reserved_at")
  expiresAt     DateTime?                @map("expires_at")
  assignedAt    DateTime?                @map("assigned_at")
  releasedAt    DateTime?                @map("released_at")
  releaseReason String?                  @map("release_reason")
  actorStaffId  String?                  @map("actor_staff_id") @db.Uuid
  createdAt     DateTime                 @default(now()) @map("created_at")

  @@index([serverId, status])
  @@index([schoolId, status])
  @@map("database_allocations")
}

model DatabaseServerActivity {
  id           String         @id @db.Uuid
  serverId     String         @map("server_id") @db.Uuid
  server       DatabaseServer @relation(fields: [serverId], references: [id], onDelete: Cascade)
  type         String
  actorStaffId String?        @map("actor_staff_id") @db.Uuid
  details      Json?
  occurredAt   DateTime       @map("occurred_at")

  @@index([serverId, occurredAt(sort: Desc)])
  @@map("database_server_activity")
}

// =============================================================================
//  CÓPIAS DE SEGURANÇA das BDs dos colégios
//  Feitas pelo provisioner (pg_dump), cifradas com AES-256-GCM ANTES de sair
//  e guardadas no armazenamento externo (UploadThing, privado).
// =============================================================================

enum BackupStatus {
  PENDING
  RUNNING
  DONE
  FAILED
  /// apagada do armazenamento (fim da retenção)
  DELETED
}

enum BackupTrigger {
  MANUAL
  AUTOMATIC
  /// cópia de segurança feita automaticamente ANTES de um restauro
  PRE_RESTORE
}

enum RestoreStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

/// Restauro de uma cópia na BD do PRÓPRIO colégio da cópia (fila para o provisioner).
model DatabaseRestore {
  id             String         @id @db.Uuid
  schoolId       String         @map("school_id") @db.Uuid
  school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  backupId       String         @map("backup_id") @db.Uuid
  /// relação composta: a cópia TEM de ser do mesmo colégio (garantido pela própria BD)
  backup         DatabaseBackup @relation("RestoredFrom", fields: [backupId, schoolId], references: [id, schoolId])
  status         RestoreStatus  @default(PENDING)
  requestedById  String         @map("requested_by_id") @db.Uuid
  reason         String
  /// cópia do estado ANTERIOR, feita pelo provisioner antes de restaurar
  safetyBackupId String?        @map("safety_backup_id") @db.Uuid
  /// o restauro falhou e a BD voltou ao estado anterior?
  rolledBack     Boolean        @default(false) @map("rolled_back")
  error          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  startedAt      DateTime?      @map("started_at")
  completedAt    DateTime?      @map("completed_at")

  @@index([schoolId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("database_restores")
}

model DatabaseBackup {
  id            String        @id @db.Uuid
  schoolId      String        @map("school_id") @db.Uuid
  school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  serverId      String?       @map("server_id") @db.Uuid
  trigger       BackupTrigger
  status        BackupStatus  @default(PENDING)
  requestedById String?       @map("requested_by_id") @db.Uuid
  /// Chave do ficheiro no armazenamento (nunca um URL público)
  storageKey    String?       @map("storage_key")
  /// Tamanho do ficheiro cifrado
  sizeBytes     BigInt?       @map("size_bytes")
  /// Tamanho da BD no momento da cópia
  databaseBytes BigInt?       @map("database_bytes")
  sha256        String?
  error         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  startedAt     DateTime?     @map("started_at")
  completedAt   DateTime?     @map("completed_at")

  restores DatabaseRestore[] @relation("RestoredFrom")

  @@unique([id, schoolId])
  @@index([schoolId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("database_backups")
}

// =============================================================================
//  VERIFICAÇÃO POR EMAIL — códigos de 6 dígitos (criar conta, repor senha)
//  Só se guardam hashes. Limites por email/finalidade: ver libs/kernel email-otp.
// =============================================================================

enum EmailVerificationPurpose {
  STAFF_SIGN_UP
  STAFF_PASSWORD_RESET
  SCHOOL_SIGN_UP
  SCHOOL_PASSWORD_RESET
  SCHOOL_EMAIL_CHANGE
}

model EmailVerification {
  id             String                   @id @db.Uuid
  purpose        EmailVerificationPurpose
  email          String
  codeHash       String                   @map("code_hash")
  attempts       Int                      @default(0)
  expiresAt      DateTime                 @map("expires_at")
  verifiedAt     DateTime?                @map("verified_at")
  /// Prova de que o código foi confirmado (hash de um token de 256 bits, uso único)
  proofHash      String?                  @unique @map("proof_hash")
  proofExpiresAt DateTime?                @map("proof_expires_at")
  proofUsedAt    DateTime?                @map("proof_used_at")
  createdAt      DateTime                 @map("created_at")

  @@index([purpose, email, createdAt(sort: Desc)])
  @@map("email_verifications")
}

model SubscriptionOrder {
  id               String      @id @db.Uuid
  number           String      @unique
  schoolId         String      @map("school_id") @db.Uuid
  school           School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  planId           String      @map("plan_id") @db.Uuid
  planName         String      @map("plan_name")
  planMonthlyPrice Int         @map("plan_monthly_price")
  cycle            String
  months           Int
  subtotal         Int
  discountPct      Int         @map("discount_pct")
  total            Int
  status           OrderStatus
  paymentMethod    PaymentMethod? @map("payment_method")

  referenceEntity    String?   @map("reference_entity")
  referenceNumber    String?   @unique @map("reference_number")
  referenceExpiresAt DateTime? @map("reference_expires_at")

  bankName   String? @map("bank_name")
  bankHolder String? @map("bank_holder")
  bankIban   String? @map("bank_iban")

  transactionNumber    String?   @map("transaction_number")
  proofKey             String?   @map("proof_key")
  proofFileName        String?   @map("proof_file_name")
  proofMimeType        String?   @map("proof_mime_type")
  proofSubmittedAt     DateTime? @map("proof_submitted_at")
  proofRejectionReason String?   @map("proof_rejection_reason")

  paidAt    DateTime? @map("paid_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([schoolId, createdAt(sort: Desc)])
  @@map("subscription_orders")
}

/// Histórico do colégio (eventos de domínio do agregado School).
model SchoolActivity {
  id           String   @id @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  type         String
  actorStaffId String?  @map("actor_staff_id") @db.Uuid
  details      Json?
  occurredAt   DateTime @map("occurred_at")

  @@index([schoolId, occurredAt(sort: Desc)])
  @@map("school_activity")
}
