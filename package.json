{
  "name": "eduflow-api",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "EduFlow — API (monorepo: platform-api, school-api, provisioner)",
  "scripts": {
    "setup": "bash scripts/setup-dev.sh",
    "build": "rm -rf dist && node scripts/check-boundaries.mjs && tsc -p tsconfig.json",
    "dev": "node scripts/dev.mjs",
    "start:platform": "node --enable-source-maps dist/apps/platform-api/src/main.js",
    "start:school": "node --enable-source-maps dist/apps/school-api/src/main.js",
    "start:provisioner": "node --enable-source-maps dist/apps/provisioner/src/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:boundaries": "node scripts/check-boundaries.mjs",
    "db:up": "docker compose up -d",
    "db:generate": "prisma generate --schema prisma/platform/schema.prisma && prisma generate --schema prisma/tenant/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/platform/schema.prisma && bash scripts/db-grants.sh",
    "db:deploy": "prisma migrate deploy --schema prisma/platform/schema.prisma && bash scripts/db-grants.sh",
    "db:tenant-sql": "prisma migrate diff --from-empty --to-schema-datamodel prisma/tenant/schema.prisma --script",
    "db:studio": "prisma studio --schema prisma/platform/schema.prisma",
    "postinstall": "prisma generate --schema prisma/platform/schema.prisma && prisma generate --schema prisma/tenant/schema.prisma"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "@nestjs/core"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^11.2.9",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.9",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.9",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3"
  }
}
